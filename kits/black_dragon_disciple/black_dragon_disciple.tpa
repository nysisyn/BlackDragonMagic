/////////////////////////////////////////////////////////////////////////////
// Black Dragon Disciple - sorcerer kit, Draconic Transformations version
//
// The kit itself is a plain sorcerer with the Dragon Disciple's d6 hit die
// and one spell slot less per spell level. Everything draconic comes from
// the Draconic Transformations (transformations/), wizard spells of levels
// 1 to 9 the disciple learns instead of a spell; each one, cast once, gives
// its effects for good and removes one spell slot of its level.
//
// Files
//   2da/clny#bdd.2da                 CLAB: spell slot penalty, level markers
//   transformations/transformations.tpa   the 18 transformations
//   transformations/claws.tpa        Claw & Bite: claws, bite, toggles
//   transformations/breath.tpa       Black Dragon Breath and its forms
//   transformations/granted_spells.tpa    spells learned through Black
//                                    Dragon Magic, Charm Reptile
//   hla/hla.tpa                      high-level abilities (BG2:EE, EET)
//
// Resources of this file
//   NY#BDL01     level 1 (CLAB): one spell slot less per spell level
//   NY#BDM10..25  levels 10, 15, 20, 25 (CLAB): level marker (spell
//                state) and the level steps of the transformations taken
//   NY#BDBRT/U   breath line projectiles (15 ft. / 30 ft.)
//   NY#BDFPT     Frightful Presence burst projectile (10 ft.)
//   NY#MELEE     range-limited projectile (Draconic Tail, Acidosis)
/////////////////////////////////////////////////////////////////////////////


// ---------------------------------------------------------------------------
// Projectiles shared by the transformations
// ---------------------------------------------------------------------------
// Breath line, built like Smashing Wave (IWDEE): an acid wave travels to the
// targeted point and hits once every creature it crosses, leaving a trail of
// acid puddles. Animations: Smashing Wave BAMs recoloured in acid green.
// Width: proximity radius around the path (16 px = 1 ft.): 40 px for a 5-ft.
// wide line, 80 px for a 10-ft. wide line (level 10). The length is the
// range of the spell header (15, then 30).
COPY ~%MOD_FOLDER%/kits/black_dragon_disciple/bam/ny#bdwav.bam~ ~override~   // travelling wave
     ~%MOD_FOLDER%/kits/black_dragon_disciple/bam/ny#bdwvt.bam~ ~override~   // trail
     ~%MOD_FOLDER%/kits/black_dragon_disciple/bam/ny#bdwvh.bam~ ~override~   // hit splash
     ~%MOD_FOLDER%/kits/black_dragon_disciple/wav/ny#bdbre.wav~ ~override~   // breath sound
LAF NY#CREATE_LINE_PRO INT_VAR speed = 20 width = 40 trail_delay = 2 STR_VAR new = ~NY#BDBRT~ bam = ~NY#BDWAV~ trail = ~NY#BDWVT~ sound = ~NY#BDBRE~ workspace = EVAL ~%ny_workspace%~ RET ny_pro_breath = pro_id END
LAF NY#CREATE_LINE_PRO INT_VAR speed = 20 width = 80 trail_delay = 2 STR_VAR new = ~NY#BDBRU~ bam = ~NY#BDWAV~ trail = ~NY#BDWVT~ sound = ~NY#BDBRE~ workspace = EVAL ~%ny_workspace%~ RET ny_pro_breath2 = pro_id END

// Frightful Presence: 10-ft. burst centred on the caster, enemies only (area
// flag 0x40, as the game's SPAR**NP projectiles; the party versions SPAR**PA
// add 0x80), nothing left of Fireball's visuals and sounds
LAF NY#CLONE_AREA_PRO INT_VAR radius_ft = 10 explosion_effect = 255 STR_VAR source = ~fireball~ new = ~NY#BDFPT~ workspace = EVAL ~%ny_workspace%~ RET ny_pro_fear = pro_id END
COPY_EXISTING ~NY#BDFPT.pro~ ~override~
  READ_LONG  0x200 ny_fear_flags
  WRITE_LONG 0x200 ((ny_fear_flags BOR 0x40) BAND (BNOT 0x80))
  WRITE_ASCII 0x10  ~~ #8           // fire sound
  WRITE_ASCII 0x18  ~~ #8           // impact sound
  WRITE_ASCII 0x104 ~~ #8           // travelling fireball
  WRITE_ASCII 0x10c ~~ #8           // its shadow
  WRITE_ASCII 0x208 ~~ #8           // explosion sound
  WRITE_ASCII 0x21c ~~ #8           // fire explosion animation
  WRITE_ASCII 0x230 ~~ #8           // flame ring
  WRITE_LONG  0x240 0               // extended area flags of the VVC / ring
BUT_ONLY

// Draconic Tail and Acidosis: range-limited projectile (about 12 ft., melee
// reach), shared with Ghostly Tail and Acidosis (spells component)
LAF NY#MELEE_RANGE_PRO STR_VAR workspace = EVAL ~%ny_workspace%~ RET ny_pro_melee = pro_id END


// ---------------------------------------------------------------------------
// Level 1 (CLAB): one spell less per day per spell level (levels 1-9,
// bitmask 0x1FF). Never below 0, follows the level ups.
// ---------------------------------------------------------------------------
CREATE ~SPL~ ~NY#BDL01~
  LPF NY#SPL_BASE INT_VAR type = 4 level = 1 END
  LPF NY#ADD_SPL_HEADER INT_VAR location = 4 target = 5 range = 1 level = 1 casting_time = 0 RET h = header END
  LPF ADD_SPELL_EFFECT INT_VAR header = h opcode = 42 target = 1 timing = 9 parameter1 = "-1" parameter2 = 0x1ff END


// ---------------------------------------------------------------------------
// Kit registration with ADD_KIT_EX (lib/a7#add_kit_ex.tpa, by Argent77).
// The kit is cloned from the Dragon Disciple: every table that is not given
// here (weapon proficiencies, alignments, race tables, CLASTEXT/SODCLTXT,
// CLSRCREQ, HPCLASS: d6, NUMWSLOT, starting equipment...) copies its row.
// ---------------------------------------------------------------------------
// High-level abilities (BG2:EE and EET): own table LUNYB.2DA, see
// hla/hla.tpa (included at the end). On BG:EE the Dragon Disciple's LUABBR
// row is copied.
ACTION_IF GAME_IS ~bg2ee eet~ BEGIN
  OUTER_SPRINT ny_luabbr ~NYB~
END ELSE BEGIN
  OUTER_SPRINT ny_luabbr ~~
END

OUTER_SET ny_kit_lower = RESOLVE_STR_REF (@1)
OUTER_SET ny_kit_mixed = RESOLVE_STR_REF (@2)
OUTER_SET ny_kit_help  = RESOLVE_STR_REF (@3)

LAF ADD_KIT_EX
  INT_VAR
    kit_class = 19                          // sorcerer
    visible   = 1                           // selectable at character creation
    lower     = ny_kit_lower
    mixed     = ny_kit_mixed
    help      = ny_kit_help
  STR_VAR
    kit_name   = ~NY#BDD~
    source_kit = ~DRAGON_DISCIPLE~
    clab_path  = EVAL ~%MOD_FOLDER%/kits/black_dragon_disciple/2da/clny#bdd.2da~
    //            STR DEX CON INT WIS CHA
    abclasrq   = ~0   0   0   9   0   9~     // sorcerer requirements
    abclsmod   = ~0   0   0   0   0   0~     // no ability modifier
    luabbr     = EVAL ~%ny_luabbr%~           // HLA table LUNYB.2DA (BG2:EE, EET)
  RET
    ny_kit_id = kit_id
END


// ---------------------------------------------------------------------------
// Transformations, then the high-level abilities (they reuse the breath
// projectiles and the granted spells)
// ---------------------------------------------------------------------------
INCLUDE ~%MOD_FOLDER%/kits/black_dragon_disciple/transformations/transformations.tpa~

ACTION_IF GAME_IS ~bg2ee eet~ BEGIN
  INCLUDE ~%MOD_FOLDER%/kits/black_dragon_disciple/hla/hla.tpa~
END
