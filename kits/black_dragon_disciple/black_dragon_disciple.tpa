/////////////////////////////////////////////////////////////////////////////
// Black Dragon Disciple - sorcerer kit
//
// Level by level progression (kit description @3). The CLAB
// (2da/clny#bdd.2da) gives every feature at its level.
//
// Resources
//   NY#BDL01..20 level bonuses (AP_ in the CLAB, permanent): AC, Constitution,
//                Swamp Stride, Acid Affinity, Blindsense, Draconic Tail,
//                Apotheosis immunities. Only the levels that give something.
//   NY#BDTH      +1 THAC0, given by the CLAB at levels 4, 7, 10... 49: with
//                the sorcerer's own progression, gives the druid's THAC0
//   NY#BDQ02..50 spell slots of a sorcerer one level lower (CLAB, one per
//                level, each one replaces the previous one)
//   NY#BDZ1..6   put the claws of the stage in the fist slot (CLAB, and the
//                global script baf/claws.baf after a load)
//   NY#BDCL1..6  claws (fist item), one per stage: levels 1, 4, 8, 12, 16, 20
//   NY#BDMZ1..6  put the bite of the stage in the off-hand slot (CLAB)
//   NY#BDMO1..6  bite (off-hand item), one per stage: levels 6, 8, 12, 13,
//                16, 20 (from the branch "bite")
//   NY#BDTL      Draconic Tail strike (fired once per round by NY#BDL09)
//   NY#BDBRE     Acid Breath (1 to 4 per day, CLAB)
//   NY#BDBRT     Acid Breath line, 15 ft. long and 5 ft. wide
//   NY#BDBRU     Acid Breath line, 30 ft. long and 10 ft. wide (level 19)
//   NY#BDWG      Draconic Wings ON  / NY#BDWH  OFF
//   NY#BDWI      the wings (helmet slot item)
//   NY#BDFP      Frightful Presence ON  / NY#BDFQ  OFF
//   NY#BDFPE     aura pulse (EFF)      / NY#BDFPA  pulse spell
//
// Not done yet (see TODO.md): the Acid Affinity damage bonus.
/////////////////////////////////////////////////////////////////////////////

// ---------------------------------------------------------------------------
// Strings
// ---------------------------------------------------------------------------
OUTER_SET ny_str_claws       = RESOLVE_STR_REF (@10)
OUTER_SET ny_str_claws_d1    = RESOLVE_STR_REF (@11)
OUTER_SET ny_str_claws_d2    = RESOLVE_STR_REF (@12)
OUTER_SET ny_str_claws_d3    = RESOLVE_STR_REF (@13)
OUTER_SET ny_str_claws_d4    = RESOLVE_STR_REF (@14)
OUTER_SET ny_str_claws_d5    = RESOLVE_STR_REF (@15)
OUTER_SET ny_str_claws_d6    = RESOLVE_STR_REF (@16)
OUTER_SET ny_str_bite        = RESOLVE_STR_REF (@19)
OUTER_SET ny_str_bite_d1     = RESOLVE_STR_REF (@20)
OUTER_SET ny_str_bite_d2     = RESOLVE_STR_REF (@21)
OUTER_SET ny_str_bite_d3     = RESOLVE_STR_REF (@22)
OUTER_SET ny_str_bite_d4     = RESOLVE_STR_REF (@23)
OUTER_SET ny_str_bite_d5     = RESOLVE_STR_REF (@24)
OUTER_SET ny_str_bite_d6     = RESOLVE_STR_REF (@25)
OUTER_SET ny_str_tail        = RESOLVE_STR_REF (@26)
OUTER_SET ny_str_breath      = RESOLVE_STR_REF (@30)
OUTER_SET ny_str_breath_d    = RESOLVE_STR_REF (@31)
OUTER_SET ny_str_fear_on     = RESOLVE_STR_REF (@40)
OUTER_SET ny_str_fear_on_d   = RESOLVE_STR_REF (@41)
OUTER_SET ny_str_fear_off    = RESOLVE_STR_REF (@42)
OUTER_SET ny_str_fear_off_d  = RESOLVE_STR_REF (@43)
OUTER_SET ny_str_wings       = RESOLVE_STR_REF (@60)
OUTER_SET ny_str_wings_d     = RESOLVE_STR_REF (@61)
OUTER_SET ny_str_wings_on_d  = RESOLVE_STR_REF (@62)
OUTER_SET ny_str_wings_off   = RESOLVE_STR_REF (@63)
OUTER_SET ny_str_wings_off_d = RESOLVE_STR_REF (@64)


// ---------------------------------------------------------------------------
// Icons
// ---------------------------------------------------------------------------
// Claws: default fist icon. Opcode 143 does not equip the claws, so after a
// load the weapon button keeps the default fist picture: a custom icon would
// only show at character creation (placeholder until a custom icon)
OUTER_SPRINT ny_icon_claws ~FIST~
// Acid Breath: Nysi's acid breath artwork, tilted 40 degrees and reduced to
// 32 px on a stone plate (source in works/acid_breath_icon_source; the old
// DragonAscendant icon is kept in works/acid_breath_old_icon)
COPY ~%MOD_FOLDER%/kits/black_dragon_disciple/bam/ny#bdbri.bam~ ~override~
OUTER_SPRINT ny_icon_breath ~NY#BDBRI~
// Bite: test icon, the Corrosive Spit icon recoloured in yellow (branch bite)
COPY ~%MOD_FOLDER%/kits/black_dragon_disciple/bam/ny#bdmi.bam~ ~override~
OUTER_SPRINT ny_icon_bite ~NY#BDMI~
// Wings: the game's Black Dragon Wing Buffet icon (SPIN695B, placeholder)
OUTER_SPRINT ny_icon_wings ~SPIN695B~


// ---------------------------------------------------------------------------
// Spell Immunities to Frightful Presence
// ---------------------------------------------------------------------------
OUTER_SET ny_ids_level     = IDS_OF_SYMBOL (~stats~ ~LEVEL~)

// immune when not an enemy of the party (EA < EVILCUTOFF)
LAF NY#SPLPROT_ROW STR_VAR label = ~NY#EA<200~ stat = ~0x10a~ value = ~200~ relation = ~2~ RET ny_prot_not_enemy = row END
// immune when LEVEL >= opcode parameter1
LAF NY#SPLPROT_ROW STR_VAR label = ~NY#LEVEL>=PARAM~ stat = EVAL ~%ny_ids_level%~ value = ~-1~ relation = ~4~ RET ny_prot_level = row END


// ---------------------------------------------------------------------------
// Projectiles
// ---------------------------------------------------------------------------
// Acid Breath: real line, built like Smashing Wave (IWDEE): an acid wave
// travels to the targeted point and hits once every creature it crosses,
// leaving a trail of acid puddles. Slower than Smashing Wave (20 instead of
// 40) so the line can be seen. Animations: Smashing Wave BAMs recoloured in
// acid green.
// Width: proximity radius around the path (16 px = 1 ft.): 40 px for a
// 5-ft. wide line, 80 px for a 10-ft. wide line (level 19). The length is
// the range of the spell header (15, then 30).
COPY ~%MOD_FOLDER%/kits/black_dragon_disciple/bam/ny#bdwav.bam~ ~override~   // travelling wave
     ~%MOD_FOLDER%/kits/black_dragon_disciple/bam/ny#bdwvt.bam~ ~override~   // trail
     ~%MOD_FOLDER%/kits/black_dragon_disciple/bam/ny#bdwvh.bam~ ~override~   // hit splash
     ~%MOD_FOLDER%/kits/black_dragon_disciple/wav/ny#bdbre.wav~ ~override~   // breath sound
LAF NY#CREATE_LINE_PRO INT_VAR speed = 20 width = 40 trail_delay = 2 STR_VAR new = ~NY#BDBRT~ bam = ~NY#BDWAV~ trail = ~NY#BDWVT~ sound = ~NY#BDBRE~ workspace = EVAL ~%ny_workspace%~ RET ny_pro_breath = pro_id END
LAF NY#CREATE_LINE_PRO INT_VAR speed = 20 width = 80 trail_delay = 2 STR_VAR new = ~NY#BDBRU~ bam = ~NY#BDWAV~ trail = ~NY#BDWVT~ sound = ~NY#BDBRE~ workspace = EVAL ~%ny_workspace%~ RET ny_pro_breath2 = pro_id END
// Frightful Presence: 15-ft. burst centred on the caster, no visual
LAF NY#CLONE_AREA_PRO INT_VAR radius_ft = 15 explosion_effect = 255 STR_VAR source = ~fireball~ new = ~NY#BDFPT~ RET ny_pro_fear = pro_id END
// Draconic Tail: range-limited projectile (about 12 ft., melee reach),
// shared with Ghostly Tail and Acidosis
LAF NY#MELEE_RANGE_PRO STR_VAR workspace = EVAL ~%ny_workspace%~ RET ny_pro_melee = pro_id END


// ---------------------------------------------------------------------------
// Level bonuses (AP_ in the CLAB, permanent)
// One spell per level that gives something; the effects are added below.
// ---------------------------------------------------------------------------
ACTION_FOR_EACH lvl IN ~01~ ~02~ ~04~ ~05~ ~08~ ~09~ ~10~ ~12~ ~15~ ~16~ ~20~ BEGIN
  CREATE ~SPL~ ~NY#BDL%lvl%~
    LPF NY#SPL_BASE INT_VAR type = 4 level = 1 END
    LPF NY#ADD_SPL_HEADER INT_VAR location = 4 target = 5 range = 1 level = 1 casting_time = 0 END
END

// AC +1: levels 1, 5, 10, 15, 20 (scales)
ACTION_FOR_EACH lvl IN ~01~ ~05~ ~10~ ~15~ ~20~ BEGIN
  COPY_EXISTING ~NY#BDL%lvl%.spl~ ~override~
    LPF ADD_SPELL_EFFECT INT_VAR header = 1 opcode = 0 target = 1 timing = 9 parameter1 = 1 parameter2 = 0 END
END

// Constitution +1: levels 5 and 15
ACTION_FOR_EACH lvl IN ~05~ ~15~ BEGIN
  COPY_EXISTING ~NY#BDL%lvl%.spl~ ~override~
    LPF ADD_SPELL_EFFECT INT_VAR header = 1 opcode = 10 target = 1 timing = 9 parameter1 = 1 parameter2 = 0 END
END

// Acid Affinity: acid resistance +20% at levels 4, 8, 12, 16 and 20
// (immunity at 20). The acid damage bonus (+5% per step, +25% at 20) is not
// done yet: see TODO.md.
ACTION_FOR_EACH lvl IN ~04~ ~08~ ~12~ ~16~ ~20~ BEGIN
  COPY_EXISTING ~NY#BDL%lvl%.spl~ ~override~
    LPF ADD_SPELL_EFFECT INT_VAR header = 1 opcode = 27 target = 1 timing = 9 parameter1 = 20 parameter2 = 0 END
END

// Level 1: one spell less per day per spell level (levels 1-9, bitmask
// 0x1FF). Never below 0, follows the level ups. The Dragon Disciple uses
// MXSPLDD.2DA instead, tied to that kit by the engine.
COPY_EXISTING ~NY#BDL01.spl~ ~override~
  LPF ADD_SPELL_EFFECT INT_VAR header = 1 opcode = 42 target = 1 timing = 9 parameter1 = "-1" parameter2 = 0x1ff END

// Level 2 - Swamp Stride: Entangle, Grease, Web
COPY_EXISTING ~NY#BDL02.spl~ ~override~
  LPF ADD_SPELL_EFFECT INT_VAR header = 1 opcode = 206 target = 1 timing = 9 parameter1 = "-1" STR_VAR resource = ~SPPR105~ END
  LPF ADD_SPELL_EFFECT INT_VAR header = 1 opcode = 206 target = 1 timing = 9 parameter1 = "-1" STR_VAR resource = ~SPWI101~ END
  LPF ADD_SPELL_EFFECT INT_VAR header = 1 opcode = 206 target = 1 timing = 9 parameter1 = "-1" STR_VAR resource = ~SPWI215~ END
  LPF ADD_SPELL_EFFECT INT_VAR header = 1 opcode = 101 target = 1 timing = 9 parameter2 = 157 END   // web state from other sources

// Level 10 - Blindsense: immunity to blindness, see and target invisible
// creatures at any range (opcode 193, as the Artisan's Kitpack Dragon
// Disciple).
COPY_EXISTING ~NY#BDL10.spl~ ~override~
  LPF ADD_SPELL_EFFECT INT_VAR header = 1 opcode = 101 target = 1 timing = 9 parameter2 = 74 END
  LPF ADD_SPELL_EFFECT INT_VAR header = 1 opcode = 193 target = 1 timing = 9 parameter2 = 1 END

// Level 20 - Draconic Apotheosis: immunity to sleep and paralysis
COPY_EXISTING ~NY#BDL20.spl~ ~override~
  LPF ADD_SPELL_EFFECT INT_VAR header = 1 opcode = 101 target = 1 timing = 9 parameter2 = 39  END   // sleep / unconsciousness
  LPF ADD_SPELL_EFFECT INT_VAR header = 1 opcode = 101 target = 1 timing = 9 parameter2 = 109 END   // paralysis
  LPF ADD_SPELL_EFFECT INT_VAR header = 1 opcode = 101 target = 1 timing = 9 parameter2 = 175 END   // hold
  LPF ADD_SPELL_EFFECT INT_VAR header = 1 opcode = 101 target = 1 timing = 9 parameter2 = 185 END   // hold II

// Druid THAC0: THAC0.2DA follows the class, not the kit. The sorcerer gains
// 1 point at levels 4, 7, 10..., the druid 2: the CLAB gives +1 at each of
// these levels (row ABILITY4).
CREATE ~SPL~ ~NY#BDTH~
  LPF NY#SPL_BASE INT_VAR type = 4 level = 1 END
  LPF NY#ADD_SPL_HEADER INT_VAR location = 4 target = 5 range = 1 level = 1 casting_time = 0 RET h = header END
  LPF ADD_SPELL_EFFECT INT_VAR header = h opcode = 54 target = 1 timing = 9 parameter1 = 1 parameter2 = 0 END


// ---------------------------------------------------------------------------
// Spell progression of a sorcerer one level lower
//
// At level N the disciple must have the spell slots of a level N-1
// sorcerer: the CLAB applies NY#BDQnn at each level N from 2 to 50. It first
// removes the previous one (opcode 321), then lowers each spell level by
// (slots at N) - (slots at N-1), read from the game's MXSPLSRC.2DA at
// install time. The penalty is not cumulative: only the last NY#BDQnn is
// active. The one spell less per day (NY#BDL01) comes on top.
// Spells known (SPLSRCKN.2DA) are not delayed: the disciple may learn a
// spell one level before he can cast it.
// ---------------------------------------------------------------------------
COPY_EXISTING ~mxsplsrc.2da~ ~override~
  COUNT_2DA_ROWS 10 ny_mx_rows
  FOR (r = 0; r < ny_mx_rows; ++r) BEGIN
    FOR (c = 1; c <= 9; ++c) BEGIN
      READ_2DA_ENTRY r c 10 v
      PATCH_IF NOT (IS_AN_INT v) BEGIN SET v = 0 END
      SET $ny_mx(~%r%~ ~%c%~) = v
    END
  END
BUT_ONLY

OUTER_FOR (lvl = 2; lvl <= 50; ++lvl) BEGIN
  OUTER_SPRINT nn ~%lvl%~
  ACTION_IF (lvl < 10) BEGIN OUTER_SPRINT nn ~0%lvl%~ END
  OUTER_SET prev = lvl - 1
  OUTER_SPRINT pp ~%prev%~
  ACTION_IF (prev < 10) BEGIN OUTER_SPRINT pp ~0%prev%~ END
  CREATE ~SPL~ ~NY#BDQ%nn%~
    LPF NY#SPL_BASE INT_VAR type = 4 level = 1 END
    LPF NY#ADD_SPL_HEADER INT_VAR location = 4 target = 5 range = 1 level = 1 casting_time = 0 RET h = header END
    PATCH_IF (lvl > 2) BEGIN
      LPF ADD_SPELL_EFFECT INT_VAR header = h opcode = 321 target = 1 timing = 1 STR_VAR resource = EVAL ~NY#BDQ%pp%~ END
    END
    // rows of MXSPLSRC.2DA: row 0 = level 1
    PATCH_IF (lvl <= ny_mx_rows) BEGIN
      FOR (c = 1; c <= 9; ++c) BEGIN
        SET r_now  = lvl - 1
        SET r_prev = lvl - 2
        SET diff = $ny_mx(~%r_now%~ ~%c%~) - $ny_mx(~%r_prev%~ ~%c%~)
        PATCH_IF (diff > 0) BEGIN
          LPF ADD_SPELL_EFFECT INT_VAR header = h opcode = 42 target = 1 timing = 9 parameter1 = (0 - diff) parameter2 = (1 BLSL (c - 1)) END
        END
      END
    END
END


// ---------------------------------------------------------------------------
// Draconic Tail (level 9): once per round, the tail strikes the nearest
// enemy in melee reach: save vs. Breath or 1d10 crushing damage and knocked
// prone (unconscious) for 1 second.
// Built like Ghostly Tail: a permanent opcode 232 on the disciple (condition
// HPPercentLT(Myself,102), always true, checked once per round; target
// NearestEnemyOf) fires NY#BDTL with the range-limited projectile NY#MELEE:
// no enemy in reach = no strike that round.
// ---------------------------------------------------------------------------
CREATE ~SPL~ ~NY#BDTL~
  LPF NY#SPL_BASE INT_VAR type = 4 level = 1 flags = 0x400 END
  LPF NY#ADD_SPL_HEADER INT_VAR location = 4 target = 1 range = 1000 level = 1 casting_time = 0 projectile = ny_pro_melee RET h = header END
  LPF ADD_SPELL_EFFECT INT_VAR header = h opcode = 12  target = 2 timing = 0 parameter2 = 0 dicenumber = 1 dicesize = 10 savingthrow = 2 END
  LPF ADD_SPELL_EFFECT INT_VAR header = h opcode = 39  target = 2 timing = 0 duration = 1 parameter2 = 0 savingthrow = 2 END
  LPF ADD_SPELL_EFFECT INT_VAR header = h opcode = 215 target = 2 timing = 0 duration = 1 parameter2 = 1 savingthrow = 2 STR_VAR resource = ~SPSDIMPA~ END
  LPF ADD_SPELL_EFFECT INT_VAR header = h opcode = 139 target = 2 timing = 1 parameter1 = ny_str_tail savingthrow = 2 END   // combat log

// opcode 232 must stay the last (here the only) effect of the spell
COPY_EXISTING ~NY#BDL09.spl~ ~override~
  LPF ADD_SPELL_EFFECT INT_VAR header = 1 opcode = 232 target = 1 timing = 9 parameter1 = 2 parameter2 = 20 special = 102 STR_VAR resource = ~NY#BDTL~ END


// ---------------------------------------------------------------------------
// Draconic Claws: one item per stage, in the fist slot (see below): their
// equipped effects (2 attacks per round) only apply when the disciple fights
// unarmed, which is always the case since he cannot use weapons.
// Stages: levels 1, 4, 8, 12, 16, 20.
// ---------------------------------------------------------------------------
DEFINE_ACTION_FUNCTION NY#BDD_CLAWS
  INT_VAR
    stage  = 1
    name   = "-1"
    desc   = "-1"
    sides  = 4
    thrown = 1
  STR_VAR
    icon  = ~~
BEGIN
  CREATE ~ITM~ ~NY#BDCL%stage%~
    WRITE_LONG  0x08 name
    WRITE_LONG  0x0c name
    // flags as FIST.ITM (0x20) + magical (0x40)
    WRITE_LONG  0x18 0x60
    WRITE_SHORT 0x1c 0x1c                       // hand-to-hand weapon
    WRITE_EVALUATED_ASCII 0x3a ~%icon%~ #8
    WRITE_LONG  0x50 desc
    WRITE_LONG  0x54 desc
    WRITE_EVALUATED_ASCII 0x58 ~%icon%~ #8
    WRITE_LONG  0x60 (stage - 1)                // enchantment, also to-hit/damage bonus

    // 2 attacks per round from level 1, never more
    LPF ADD_ITEM_EQEFFECT INT_VAR opcode = 1 target = 1 timing = 2 parameter1 = 2 parameter2 = 1 END

    // melee: slashing, strength bonus applies
    // id_req = 0 as FIST.ITM: the ability (and its icon) is always available
    // to-hit and damage bonus = enchantment (+0 to +5), as magical weapons
    LPF NY#ADD_ITM_HEADER INT_VAR attack_type = 1 id_req = 0 location = 1 target = 1 range = 1 speed = 2
                                  thac0 = (stage - 1) damage_bonus = (stage - 1)
                                  dice_sides = sides dice_thrown = thrown damage_type = 3 flags = 1
                         STR_VAR icon END
END

LAF NY#BDD_CLAWS INT_VAR stage = 1 name = ny_str_claws desc = ny_str_claws_d1 sides = 4  thrown = 1 STR_VAR icon = EVAL ~%ny_icon_claws%~ END
LAF NY#BDD_CLAWS INT_VAR stage = 2 name = ny_str_claws desc = ny_str_claws_d2 sides = 6  thrown = 1 STR_VAR icon = EVAL ~%ny_icon_claws%~ END
LAF NY#BDD_CLAWS INT_VAR stage = 3 name = ny_str_claws desc = ny_str_claws_d3 sides = 8  thrown = 1 STR_VAR icon = EVAL ~%ny_icon_claws%~ END
LAF NY#BDD_CLAWS INT_VAR stage = 4 name = ny_str_claws desc = ny_str_claws_d4 sides = 10 thrown = 1 STR_VAR icon = EVAL ~%ny_icon_claws%~ END
LAF NY#BDD_CLAWS INT_VAR stage = 5 name = ny_str_claws desc = ny_str_claws_d5 sides = 6  thrown = 2 STR_VAR icon = EVAL ~%ny_icon_claws%~ END
LAF NY#BDD_CLAWS INT_VAR stage = 6 name = ny_str_claws desc = ny_str_claws_d6 sides = 8  thrown = 2 STR_VAR icon = EVAL ~%ny_icon_claws%~ END

// ---------------------------------------------------------------------------
// Claws in the fist slot
//
// NY#BDZn.SPL removes the claws of the previous stages (opcode 112) and
// creates the claws NY#BDCLn (opcode 143, slot 10 = FIST). It is
// applied by the CLAB at levels 1, 4, 8, 12, 16 and 20.
// The engine does not save the fist slot: after a load the default fist is
// back. The global script baf/claws.baf puts the claws back (method of the
// Arcane Fist kit). Repeating or permanent effects (opcodes 177, 272) were
// tried first: they are kept in saved games but never brought the claws back.
// ---------------------------------------------------------------------------
OUTER_FOR (s = 1; s <= 6; ++s) BEGIN
  CREATE ~SPL~ ~NY#BDZ%s%~
    LPF NY#SPL_BASE INT_VAR type = 4 level = 1 flags = 0x200 END
    LPF NY#ADD_SPL_HEADER INT_VAR location = 4 target = 1 range = 1 level = 1 casting_time = 0 RET h = header END
    // remove the claws of the previous stages first (opcode 112 removes
    // equipped items): opcode 143 may not replace an item already in the slot
    FOR (k = 1; k < s; ++k) BEGIN
      LPF ADD_SPELL_EFFECT INT_VAR header = h opcode = 112 target = 2 timing = 1 STR_VAR resource = EVAL ~NY#BDCL%k%~ END
    END
    LPF ADD_SPELL_EFFECT INT_VAR header = h opcode = 143 target = 2 timing = 1 parameter1 = 10 STR_VAR resource = EVAL ~NY#BDCL%s%~ END
END


// ---------------------------------------------------------------------------
// Draconic Bite (from the branch "bite", tested in game): one item per
// stage, in the off-hand slot (opcode 143, slot 9 = SHIELD) from level 6, so
// the disciple fights with the claws in the main hand (fist slot) and the
// bite in the off hand: one more attack per round (engine rule for an
// off-hand weapon).
// Stages: levels 6, 8, 12, 13, 16, 20. 1d6 piercing + 1d4 acid, then 2d6 +
// 2d4 acid from level 13 (acid: effect of the attack, with the acid splash).
// Enchantment and to-hit/damage bonus as the claws of the same level (+1 at
// 6, +2 at 8, +3 at 12 and 13, +4 at 16, +5 at 20).
// The normal two-weapon penalties apply: the player lowers them with
// Two-Weapon Style (up to 3 points, see the proficiencies below).
// Hand-to-hand weapon (0x1c) as the claws, movable: the disciple can put it
// in the backpack to fight with the claws alone (Single Weapon Style). The
// off-hand slot is saved: no global script for the bite.
// NY#BDMZn (CLAB) removes the bites of the previous stages, equipped
// (opcode 112) or in the backpack (opcode 123), and creates the bite of the
// stage.
// ---------------------------------------------------------------------------
DEFINE_ACTION_FUNCTION NY#BDD_BITE
  INT_VAR
    stage   = 1
    desc    = "-1"
    enchant = 1
    thrown  = 1
BEGIN
  CREATE ~ITM~ ~NY#BDMO%stage%~
    WRITE_LONG  0x08 ny_str_bite
    WRITE_LONG  0x0c ny_str_bite
    // movable (0x04) + flags as FIST.ITM (0x20) + magical (0x40)
    WRITE_LONG  0x18 0x64
    WRITE_SHORT 0x1c 0x1c                       // hand-to-hand weapon
    WRITE_EVALUATED_ASCII 0x3a ~%ny_icon_bite%~ #8
    WRITE_LONG  0x50 desc
    WRITE_LONG  0x54 desc
    WRITE_EVALUATED_ASCII 0x58 ~%ny_icon_bite%~ #8
    WRITE_LONG  0x60 enchant

    LPF NY#ADD_ITM_HEADER INT_VAR attack_type = 1 id_req = 0 location = 1 target = 1 range = 1 speed = 2
                                  thac0 = enchant damage_bonus = enchant
                                  dice_sides = 6 dice_thrown = thrown damage_type = 1 flags = 1
                         STR_VAR icon = EVAL ~%ny_icon_bite%~ RET h = header END
    LPF ADD_ITEM_EFFECT INT_VAR type = 99 header = h opcode = 12  target = 2 timing = 1 parameter2 = 0x10000 dicenumber = thrown dicesize = 4 END
    LPF ADD_ITEM_EFFECT INT_VAR type = 99 header = h opcode = 215 target = 2 timing = 0 duration = 1 parameter2 = 1 STR_VAR resource = ~SHACID~ END
END

LAF NY#BDD_BITE INT_VAR stage = 1 desc = ny_str_bite_d1 enchant = 1 thrown = 1 END   // level 6
LAF NY#BDD_BITE INT_VAR stage = 2 desc = ny_str_bite_d2 enchant = 2 thrown = 1 END   // level 8
LAF NY#BDD_BITE INT_VAR stage = 3 desc = ny_str_bite_d3 enchant = 3 thrown = 1 END   // level 12
LAF NY#BDD_BITE INT_VAR stage = 4 desc = ny_str_bite_d4 enchant = 3 thrown = 2 END   // level 13
LAF NY#BDD_BITE INT_VAR stage = 5 desc = ny_str_bite_d5 enchant = 4 thrown = 2 END   // level 16
LAF NY#BDD_BITE INT_VAR stage = 6 desc = ny_str_bite_d6 enchant = 5 thrown = 2 END   // level 20

OUTER_FOR (s = 1; s <= 6; ++s) BEGIN
  CREATE ~SPL~ ~NY#BDMZ%s%~
    LPF NY#SPL_BASE INT_VAR type = 4 level = 1 flags = 0x200 END
    LPF NY#ADD_SPL_HEADER INT_VAR location = 4 target = 1 range = 1 level = 1 casting_time = 0 RET h = header END
    FOR (k = 1; k < s; ++k) BEGIN
      LPF ADD_SPELL_EFFECT INT_VAR header = h opcode = 112 target = 2 timing = 1 STR_VAR resource = EVAL ~NY#BDMO%k%~ END
      LPF ADD_SPELL_EFFECT INT_VAR header = h opcode = 123 target = 2 timing = 1 STR_VAR resource = EVAL ~NY#BDMO%k%~ END
    END
    LPF ADD_SPELL_EFFECT INT_VAR header = h opcode = 143 target = 2 timing = 1 parameter1 = 9 STR_VAR resource = EVAL ~NY#BDMO%s%~ END
END


// ---------------------------------------------------------------------------
// Acid Breath: line of acid, save vs. Breath for half
//   level 3: 4d4, 7: 6d4, 11: 8d4, 17: 10d4 (15 ft. x 5 ft.)
//   level 19: 12d4, 30 ft. x 10 ft.
// Uses per day: 1 at level 3, +1 at 7, 11 and 17 (CLAB).
// ---------------------------------------------------------------------------
CREATE ~SPL~ ~NY#BDBRE~
  LPF NY#SPL_BASE INT_VAR name = ny_str_breath desc = ny_str_breath_d type = 4 level = 1 flags = 0x400 STR_VAR icon = EVAL ~%ny_icon_breath%~ END
  FOR (i = 0; i < 5; ++i) BEGIN
    SET lvl  = (i = 0) ? 3 : ((i = 1) ? 7 : ((i = 2) ? 11 : ((i = 3) ? 17 : 19)))
    SET dice = 4 + (2 * i)                       // 4d4 .. 12d4
    SET pro  = (i = 4) ? ny_pro_breath2 : ny_pro_breath
    SET rng  = (i = 4) ? 30 : 15
    LPF NY#ADD_SPL_HEADER INT_VAR location = 4 target = 4 range = rng level = lvl casting_time = 1 projectile = pro STR_VAR icon = EVAL ~%ny_icon_breath%~ RET h = header END
    // the wave starts on the disciple: 2 seconds of immunity to his own
    // breath, applied on casting before the wave leaves
    LPF ADD_SPELL_EFFECT INT_VAR header = h opcode = 206 target = 1 timing = 0 duration = 2 parameter1 = "-1" STR_VAR resource = ~NY#BDBRE~ END
    LPF ADD_SPELL_EFFECT INT_VAR header = h opcode = 215 target = 2 timing = 0 duration = 1 STR_VAR resource = ~NY#BDWVH~ END
    LPF ADD_SPELL_EFFECT INT_VAR header = h opcode = 12 target = 2 timing = 0 parameter2 = 0x10000 dicenumber = dice dicesize = 4 savingthrow = 2 special = 0x100 END
  END


// ---------------------------------------------------------------------------
// Draconic Wings (level 14): an item in the helmet slot (opcode 143, slot 6
// = HELMET) giving +4 movement and immunity to critical hits (item flag).
// The innate ability spreads them; it is then replaced by the one that
// folds them (removes the item), and so on (ON/OFF swap themselves, as
// Frightful Presence). The helmet slot is saved: no global script.
// Not movable: the player removes them with the ability only.
// ---------------------------------------------------------------------------
CREATE ~ITM~ ~NY#BDWI~
  WRITE_LONG  0x08 ny_str_wings
  WRITE_LONG  0x0c ny_str_wings
  // flags as FIST.ITM (0x20) + magical (0x40) + toggle critical hits
  WRITE_LONG  0x18 0x02000060
  WRITE_SHORT 0x1c 7                            // helm
  WRITE_EVALUATED_ASCII 0x3a ~%ny_icon_wings%~ #8
  WRITE_LONG  0x50 ny_str_wings_d
  WRITE_LONG  0x54 ny_str_wings_d
  WRITE_EVALUATED_ASCII 0x58 ~%ny_icon_wings%~ #8
  LPF ADD_ITEM_EQEFFECT INT_VAR opcode = 126 target = 1 timing = 2 parameter1 = 4 parameter2 = 0 END

CREATE ~SPL~ ~NY#BDWG~
  LPF NY#SPL_BASE INT_VAR name = ny_str_wings desc = ny_str_wings_on_d type = 4 level = 1 STR_VAR icon = EVAL ~%ny_icon_wings%~ END
  LPF NY#ADD_SPL_HEADER INT_VAR location = 4 target = 5 range = 1 level = 1 casting_time = 0 STR_VAR icon = EVAL ~%ny_icon_wings%~ RET h = header END
  LPF ADD_SPELL_EFFECT INT_VAR header = h opcode = 143 target = 1 timing = 1 parameter1 = 6 STR_VAR resource = ~NY#BDWI~ END
  LPF ADD_SPELL_EFFECT INT_VAR header = h opcode = 172 target = 1 timing = 1 STR_VAR resource = ~NY#BDWG~ END
  LPF ADD_SPELL_EFFECT INT_VAR header = h opcode = 171 target = 1 timing = 1 STR_VAR resource = ~NY#BDWH~ END

CREATE ~SPL~ ~NY#BDWH~
  LPF NY#SPL_BASE INT_VAR name = ny_str_wings_off desc = ny_str_wings_off_d type = 4 level = 1 STR_VAR icon = EVAL ~%ny_icon_wings%~ END
  LPF NY#ADD_SPL_HEADER INT_VAR location = 4 target = 5 range = 1 level = 1 casting_time = 0 STR_VAR icon = EVAL ~%ny_icon_wings%~ RET h = header END
  LPF ADD_SPELL_EFFECT INT_VAR header = h opcode = 112 target = 1 timing = 1 STR_VAR resource = ~NY#BDWI~ END
  LPF ADD_SPELL_EFFECT INT_VAR header = h opcode = 172 target = 1 timing = 1 STR_VAR resource = ~NY#BDWH~ END
  LPF ADD_SPELL_EFFECT INT_VAR header = h opcode = 171 target = 1 timing = 1 STR_VAR resource = ~NY#BDWG~ END


// ---------------------------------------------------------------------------
// Frightful Presence (level 18): toggleable aura (ON/OFF swap themselves)
// Every round the aura casts NY#BDFPA at the disciple's level; the header of
// level L only affects enemies whose level is lower than L.
// ---------------------------------------------------------------------------
CREATE ~SPL~ ~NY#BDFPA~
  LPF NY#SPL_BASE INT_VAR type = 4 level = 1 flags = 0x400 END
  FOR (lvl = 18; lvl <= 50; ++lvl) BEGIN
    LPF NY#ADD_SPL_HEADER INT_VAR location = 4 target = 5 range = 1 level = lvl casting_time = 0 projectile = ny_pro_fear RET h = header END
    LPF ADD_SPELL_EFFECT INT_VAR header = h opcode = 324 target = 2 duration = 1 parameter2 = ny_prot_not_enemy STR_VAR resource = ~NY#BDFPA~ END
    LPF ADD_SPELL_EFFECT INT_VAR header = h opcode = 324 target = 2 duration = 1 parameter1 = lvl parameter2 = ny_prot_level STR_VAR resource = ~NY#BDFPA~ END
    LPF ADD_SPELL_EFFECT INT_VAR header = h opcode = 24  target = 2 duration = (2 * ny_round) resist_dispel = 1 savingthrow = 1 END
    LPF ADD_SPELL_EFFECT INT_VAR header = h opcode = 206 target = 2 duration = ny_day parameter1 = "-1" STR_VAR resource = ~NY#BDFPA~ END
  END

LAF NY#CREATE_EFF INT_VAR opcode = 146 target = 1 parameter2 = 1 STR_VAR eff = ~NY#BDFPE~ resource = ~NY#BDFPA~ END

CREATE ~SPL~ ~NY#BDFP~
  LPF NY#SPL_BASE INT_VAR name = ny_str_fear_on desc = ny_str_fear_on_d type = 4 level = 1 STR_VAR icon = ~SPWI205B~ END
  LPF NY#ADD_SPL_HEADER INT_VAR location = 4 target = 5 range = 1 level = 1 casting_time = 1 STR_VAR icon = ~SPWI205B~ RET h = header END
  LPF ADD_SPELL_EFFECT INT_VAR header = h opcode = 272 target = 1 timing = 1 parameter1 = ny_round parameter2 = 3 STR_VAR resource = ~NY#BDFPE~ END
  LPF ADD_SPELL_EFFECT INT_VAR header = h opcode = 172 target = 1 timing = 1 STR_VAR resource = ~NY#BDFP~ END
  LPF ADD_SPELL_EFFECT INT_VAR header = h opcode = 171 target = 1 timing = 1 STR_VAR resource = ~NY#BDFQ~ END

CREATE ~SPL~ ~NY#BDFQ~
  LPF NY#SPL_BASE INT_VAR name = ny_str_fear_off desc = ny_str_fear_off_d type = 4 level = 1 STR_VAR icon = ~SPWI205B~ END
  LPF NY#ADD_SPL_HEADER INT_VAR location = 4 target = 5 range = 1 level = 1 casting_time = 0 STR_VAR icon = ~SPWI205B~ RET h = header END
  LPF ADD_SPELL_EFFECT INT_VAR header = h opcode = 321 target = 1 timing = 1 STR_VAR resource = ~NY#BDFP~ END
  LPF ADD_SPELL_EFFECT INT_VAR header = h opcode = 172 target = 1 timing = 1 STR_VAR resource = ~NY#BDFQ~ END
  LPF ADD_SPELL_EFFECT INT_VAR header = h opcode = 171 target = 1 timing = 1 STR_VAR resource = ~NY#BDFP~ END


// ---------------------------------------------------------------------------
// Kit registration with ADD_KIT_EX (lib/a7#add_kit_ex.tpa, by Argent77).
// The kit is cloned from the Dragon Disciple: every table that is not given
// here (weapon proficiencies, alignments, race tables, CLASTEXT/SODCLTXT,
// CLSRCREQ, HPCLASS, NUMWSLOT, starting equipment...) copies its row.
// ---------------------------------------------------------------------------
OUTER_SET ny_kit_lower = RESOLVE_STR_REF (@1)
OUTER_SET ny_kit_mixed = RESOLVE_STR_REF (@2)
OUTER_SET ny_kit_help  = RESOLVE_STR_REF (@3)

LAF ADD_KIT_EX
  INT_VAR
    kit_class = 19                          // sorcerer
    visible   = 1                           // selectable at character creation
    lower     = ny_kit_lower
    mixed     = ny_kit_mixed
    help      = ny_kit_help
  STR_VAR
    kit_name   = ~NY#BDD~
    source_kit = ~DRAGON_DISCIPLE~
    clab_path  = EVAL ~%MOD_FOLDER%/kits/black_dragon_disciple/2da/clny#bdd.2da~
    //            STR DEX CON INT WIS CHA
    abclasrq   = ~0   0   0   9   0   9~     // sorcerer requirements
    abclsmod   = ~0   0   0   0   0   0~     // no ability modifier
  RET
    ny_kit_id = kit_id
END

OUTER_SET ny_kit_value = IDS_OF_SYMBOL (~kit~ ~NY#BDD~)   // 0x40xx in KIT.IDS


// ---------------------------------------------------------------------------
// Weapon proficiencies: no weapon at all. The 4 proficiency points of the
// sorcerer can only go to Single Weapon Style (1 point, claws alone) and
// Two-Weapon Style (3 points, claws and bite).
// WEAPPROF.2DA: the column of the kit (header row: one entry less than the
// data rows) is set to 0 on every row except these two styles.
// ---------------------------------------------------------------------------
OUTER_SET ny_prof_single  = IDS_OF_SYMBOL (~stats~ ~PROFICIENCYSINGLEWEAPON~)
OUTER_SET ny_prof_2weapon = IDS_OF_SYMBOL (~stats~ ~PROFICIENCY2WEAPON~)

COPY_EXISTING ~weapprof.2da~ ~override~
  COUNT_2DA_COLS ncols
  SET kcol = "-1"
  READ_2DA_ENTRIES_NOW hdr (ncols - 1)          // header row first, then the data rows
  FOR (c = 0; c < (ncols - 1); ++c) BEGIN
    READ_2DA_ENTRY_FORMER hdr 0 c name
    PATCH_IF (~%name%~ STRING_EQUAL_CASE ~NY#BDD~) BEGIN SET kcol = c + 1 END
  END
  PATCH_IF (kcol < 0) BEGIN
    PATCH_FAIL ~BlackDragonMagic: column NY#BDD not found in WEAPPROF.2DA~
  END
  READ_2DA_ENTRIES_NOW rows ncols               // data rows only
  FOR (r = 0; r < rows; ++r) BEGIN
    READ_2DA_ENTRY_FORMER rows r 1 id
    SET value = 0
    PATCH_IF (IS_AN_INT id) BEGIN
      PATCH_IF (id = ny_prof_single)  BEGIN SET value = 1 END
      PATCH_IF (id = ny_prof_2weapon) BEGIN SET value = 3 END
    END
    SET_2DA_ENTRY r kcol ncols value
  END
BUT_ONLY


// ---------------------------------------------------------------------------
// No weapon: every weapon of the game gets an item usability effect (opcode
// 319, EE) that forbids it to the kit (parameter2 9 = KIT.IDS, parameter1 =
// the kit's value). Only the items present at install time are patched:
// install this component after the mods that add weapons.
// Categories: bows, daggers, maces, slings, small swords, large swords,
// hammers, morning stars, flails, darts, axes, quarterstaves, crossbows,
// spears, halberds, clubs, greatswords, bastard swords (hand-to-hand
// weapons, 28, are left alone: fists, claws and the bite).
// ---------------------------------------------------------------------------
COPY_EXISTING_REGEXP GLOB ~^.+\.itm$~ ~override~
  PATCH_IF (SOURCE_SIZE > 0x71) BEGIN
    READ_SHORT 0x1c cat
    PATCH_IF ((cat >= 15 AND cat <= 27) OR cat = 29 OR cat = 30 OR cat = 44 OR cat = 57 OR cat = 69) BEGIN
      LPF ADD_ITEM_EQEFFECT INT_VAR opcode = 319 target = 1 timing = 2 parameter1 = ny_kit_value parameter2 = 9 END
    END
  END
BUT_ONLY


// ---------------------------------------------------------------------------
// Global script: claws back after a load (see baf/claws.baf).
// Added at the top of the main game scripts, with Continue() in each block.
// ---------------------------------------------------------------------------
ACTION_FOR_EACH ny_script IN ~baldur~ ~bdbaldur~ ~baldur25~ BEGIN
  ACTION_IF FILE_EXISTS_IN_GAME ~%ny_script%.bcs~ BEGIN
    EXTEND_TOP ~%ny_script%.bcs~ ~%MOD_FOLDER%/kits/black_dragon_disciple/baf/claws.baf~ EVALUATE_BUFFER
  END
END
