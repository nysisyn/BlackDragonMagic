/////////////////////////////////////////////////////////////////////////////
// Black Dragon Breath (Breath Weapon, Meta-breath, Breath Mastery, Acid
// Mastery)
//
// The breath is an innate ability that removes itself when used and comes
// back after its recharge: the breath spell removes every breath ability
// (opcode 172) and sets the state NY_BDD_BRCD for the recharge. The global
// script (transformations.tpa) casts the breath choice NY#KBRT on a
// disciple who has no breath ability left and is not recharging: after the
// recharge, and also when the ability was spent without breathing (aiming
// cancelled, no form picked in the menu) or the recharge was lost (death).
// The choice sets the state NY_BDD_BRCH for 10 seconds (the script waits)
// and gives the ability that fits the transformations taken; nothing while
// the breath recharges (opcode 324 on the state in the final spells):
//   - Breath Weapon alone: the cone (NY#TBA<m><a>), recharge 10 rounds
//   - Meta-breath (with or without Breath Weapon): a menu (opcode 214,
//     NY#TBM<m><a>.2DA) of the cone (NY#TBL), Breath Ball (NY#TBB), Breath
//     Pool (NY#TBP) and Animate Breath (NY#TBS: the animated breath of the
//     spell Black Dragon Animate Breath, creatures/animated_breath, for 1
//     turn); recharge 6, 10, 8 and 12 rounds
//   m = N, or X with Breath Mastery: damage dice doubled, recharges 2 rounds
//   shorter; a = 1 with Acid Mastery: the acid lowers the targets' AC
//   (NY#TAMR)
// Damage: 4d4, 6d4 from level 7, 8d4 from level 10 (headers by level), save
// vs. Breath for half; the pool deals half the dice each round. The breath
// ignores magic resistance (resist_dispel 0).
// NY#KBRF (cast by the breath transformations) cancels the pending
// recharge (opcode 321 on every breath spell) and casts the choice at
// once.
//
// Projectiles
//   NY#BDBRT    cone: the Dragon Disciple's, with the explosion below
//               (black_dragon_disciple.tpa; NY#BDBRT/U: the former acid wave
//               lines when the cone cannot be built)
//   NY#TBBP     ball: Fireball with the explosion of Breath Doom (the
//               game's black dragon breath GREEHIT.PRO: sound, explosion
//               animation SPBDIMSP, spread SPBDRAE2, effect, colour, flags);
//               it travels as a green orb (Pooling Breath's acid blob
//               NY#PBRT, no smoke)
//   NY#TBPX     pool, first: the same explosion at the pool's size; it casts
//               the pool where it explodes (opcode 148, NY#TQ<m><a><i>)
//   NY#TBPP     pool, then: Stinking Cloud's CLOUD.PRO with the breaths'
//               explosion scattered over it (NY#TBPS: SPBDIMSP 1.5 times
//               slower, every other frame shown twice; blended and glowing,
//               as in the breaths) instead of the cloud, 7.5-ft. radius, no
//               travelling object
/////////////////////////////////////////////////////////////////////////////

OUTER_SET ny_str_breath    = RESOLVE_STR_REF (@210)
OUTER_SET ny_str_breath_d  = RESOLVE_STR_REF (@211)
OUTER_SET ny_str_bline     = RESOLVE_STR_REF (@212)
OUTER_SET ny_str_bline_d   = RESOLVE_STR_REF (@213)
OUTER_SET ny_str_bball     = RESOLVE_STR_REF (@214)
OUTER_SET ny_str_bball_d   = RESOLVE_STR_REF (@215)
OUTER_SET ny_str_bpool     = RESOLVE_STR_REF (@216)
OUTER_SET ny_str_bpool_d   = RESOLVE_STR_REF (@217)
OUTER_SET ny_str_breath_ready = RESOLVE_STR_REF (@252)
OUTER_SET ny_str_banim     = RESOLVE_STR_REF (@254)
OUTER_SET ny_str_banim_d   = RESOLVE_STR_REF (@255)

// Icons: the former Acid Breath icon (the game's Dragon Disciple breath
// SPDD03, recoloured acid yellow) for the line and the menu; Breathball and
// Pooling Breath's icons (spells component) for the ball and the pool,
// Animate Breath's for the animated breath
COPY ~%MOD_FOLDER%/kits/black_dragon_disciple/bam/ny#bdbri.bam~ ~override~
     ~%MOD_FOLDER%/kits/black_dragon_disciple/bam/ny#bdbrc.bam~ ~override~
     ~%MOD_FOLDER%/spells/breathball/bam/ny#bdbbb.bam~ ~override~
     ~%MOD_FOLDER%/spells/breathball/bam/ny#bdbbc.bam~ ~override~
     ~%MOD_FOLDER%/spells/pooling_breath/bam/ny#pbrb.bam~ ~override~
     ~%MOD_FOLDER%/spells/pooling_breath/bam/ny#pbrc.bam~ ~override~
     ~%MOD_FOLDER%/spells/pooling_breath/bam/ny#pbrt.bam~ ~override~
     ~%MOD_FOLDER%/spells/animate_breath/bam/ny#abrb.bam~ ~override~
     ~%MOD_FOLDER%/spells/animate_breath/bam/ny#abrc.bam~ ~override~
LAF NY#ICON_B_FROM_C STR_VAR b = ~NY#BDBRI~ c = ~NY#BDBRC~ END   // Remastered Spell Icons
LAF NY#ICON_B_FROM_C STR_VAR b = ~NY#BDBBB~ c = ~NY#BDBBC~ END
LAF NY#ICON_B_FROM_C STR_VAR b = ~NY#PBRB~  c = ~NY#PBRC~  END
LAF NY#ICON_B_FROM_C STR_VAR b = ~NY#ABRB~  c = ~NY#ABRC~  END

// the animated breath (Animate Breath form), shared with the spell Black
// Dragon Animate Breath
ACTION_IF NOT FILE_EXISTS_IN_GAME ~NY#ABRM.cre~ BEGIN
  WITH_TRA ~%MOD_FOLDER%/lang/english/animate_breath.tra~
           ~%MOD_FOLDER%/lang/%LANGUAGE%/animate_breath.tra~ BEGIN
    INCLUDE ~%MOD_FOLDER%/creatures/animated_breath/animated_breath.tpa~
  END
END


// ---------------------------------------------------------------------------
// Acid Mastery: the breath lowers the targets' AC by 2 for 2 rounds, not
// cumulative (the previous one is removed first)
// ---------------------------------------------------------------------------
CREATE ~SPL~ ~NY#TAMR~
  LPF NY#SPL_BASE INT_VAR type = 4 level = 1 flags = 0x400 END
  LPF NY#ADD_SPL_HEADER INT_VAR location = 4 target = 1 range = 1000 level = 1 casting_time = 0 RET h = header END
  LPF ADD_SPELL_EFFECT INT_VAR header = h opcode = 321 target = 2 timing = 1 STR_VAR resource = ~NY#TAMR~ END
  LPF ADD_SPELL_EFFECT INT_VAR header = h opcode = 0   target = 2 timing = 0 duration = (2 * ny_round) parameter1 = "-2" parameter2 = 0 END


// ---------------------------------------------------------------------------
// Projectiles
// ---------------------------------------------------------------------------
// Breath Doom's explosion: NY#BD_EXPLOSION (black_dragon_disciple.tpa)
COPY_EXISTING ~fireball.pro~ ~%ny_workspace%/NY#TBBP.pro~
  WRITE_ASCII  0x104 ~NY#PBRT~ #8   // a green orb instead of the fireball
  WRITE_ASCII  0x10c ~~ #8          // no shadow
  WRITE_LONG   0x100 (THIS BAND (BNOT 0x2))   // no smoke
  WRITE_BYTE   0x124 86             // gradient 86: acid green (as Pooling Breath's blob)
  PATCH_IF ny_bd_expl BEGIN
    LPF NY#BD_EXPLOSION END
  END
ADD_PROJECTILE ~%ny_workspace%/NY#TBBP.pro~
OUTER_SET ny_pro_tbball = IDS_OF_SYMBOL (~projectl~ ~NY#TBBP~) + 1

COPY_EXISTING ~fireball.pro~ ~%ny_workspace%/NY#TBPX.pro~
  WRITE_ASCII 0x104 ~~ #8                       // no travelling fireball
  WRITE_ASCII 0x10c ~~ #8                       // nor its shadow
  WRITE_SHORT 0x204 128                         // the pool's size
  WRITE_SHORT 0x206 128
  PATCH_IF ny_bd_expl BEGIN
    LPF NY#BD_EXPLOSION END
  END
ADD_PROJECTILE ~%ny_workspace%/NY#TBPX.pro~
OUTER_SET ny_pro_tbpoolx = IDS_OF_SYMBOL (~projectl~ ~NY#TBPX~) + 1

COPY ~%MOD_FOLDER%/kits/black_dragon_disciple/bam/ny#tbps.bam~ ~override~
COPY_EXISTING ~cloud.pro~ ~%ny_workspace%/NY#TBPP.pro~
  WRITE_ASCII 0x104 ~~ #8                       // no travelling object
  WRITE_BYTE  0x218 86                          // gradient 86: acid green
  WRITE_ASCII 0x228 ~NY#TBPS~ #8                // the breaths' explosion, slower, instead of the cloud
  WRITE_LONG  0x240 (THIS BOR 0x6000)           // blended, glowing: no black halo
  WRITE_SHORT 0x204 128                         // half Stinking Cloud's area
  WRITE_SHORT 0x206 128
ADD_PROJECTILE ~%ny_workspace%/NY#TBPP.pro~
OUTER_SET ny_pro_tbpool = IDS_OF_SYMBOL (~projectl~ ~NY#TBPP~) + 1


// ---------------------------------------------------------------------------
// The breath abilities
// ---------------------------------------------------------------------------
// removes every breath ability (when one is used or chosen again)
DEFINE_PATCH_FUNCTION NY#TB_REMOVE_INNATES
  INT_VAR
    h = 1
BEGIN
  PATCH_FOR_EACH r IN NY#TBAN0 NY#TBAN1 NY#TBAX0 NY#TBAX1 NY#TBMN0 NY#TBMN1 NY#TBMX0 NY#TBMX1 BEGIN
    LPF ADD_SPELL_EFFECT INT_VAR header = h opcode = 172 target = 1 timing = 1 STR_VAR resource = EVAL ~%r%~ END
  END
END

// The damage of a breath, on the targets
DEFINE_PATCH_FUNCTION NY#TB_DAMAGE
  INT_VAR
    h    = 1
    dice = 4
    line = 0
    acid = 0
BEGIN
  PATCH_IF line BEGIN
    LPF ADD_SPELL_EFFECT INT_VAR header = h opcode = 215 target = 2 timing = 0 duration = 1 STR_VAR resource = ~NY#BDWVH~ END
  END
  LPF ADD_SPELL_EFFECT INT_VAR header = h opcode = 12 target = 2 timing = 0 parameter2 = 0x10000 dicenumber = dice dicesize = 4 savingthrow = 2 special = 0x100 END
  PATCH_IF acid BEGIN
    LPF ADD_SPELL_EFFECT INT_VAR header = h opcode = 146 target = 2 timing = 1 parameter2 = 1 STR_VAR resource = ~NY#TAMR~ END
  END
END

// One breath spell.
//   form : 0 cone, 1 ball, 2 pool, 3 animated breath
//   mult : 1, or 2 with Breath Mastery
//   cd   : recharge in rounds
//   sub  : the pool's prefix (6 characters): the pool itself is a second
//          spell per tier, <sub><i>, cast where the explosion lands
DEFINE_ACTION_FUNCTION NY#TB_SPELL
  INT_VAR
    form = 0
    mult = 1
    acid = 0
    cd   = 10
    name = "-1"
    desc = "-1"
  STR_VAR
    resref = ~~
    sub    = ~~
    icon_b = ~~
    icon_c = ~~
BEGIN
  // the pool: one spell per tier, damage each round (half the dice)
  ACTION_IF (form = 2) BEGIN
    OUTER_FOR (i = 0; i < 3; ++i) BEGIN
      CREATE ~SPL~ ~%sub%%i%~
        LPF NY#SPL_BASE INT_VAR name desc type = 4 level = 1 flags = 0x400 STR_VAR icon = EVAL ~%icon_c%~ END
        LPF NY#ADD_SPL_HEADER INT_VAR location = 4 target = 4 range = 30 level = 1 casting_time = 0 projectile = ny_pro_tbpool STR_VAR icon = EVAL ~%icon_b%~ RET h = header END
        LPF NY#TB_DAMAGE INT_VAR h dice = ((4 + 2 * i) * mult / 2) acid END
    END
  END

  CREATE ~SPL~ ~%resref%~
    LPF NY#SPL_BASE INT_VAR name desc type = 4 level = 1 flags = ((form = 3) ? 0 : 0x400) STR_VAR icon = EVAL ~%icon_c%~ END
    FOR (i = 0; i < 3; ++i) BEGIN
      SET lvl  = (i = 0) ? 1 : ((i = 1) ? 7 : 10)
      SET dice = (4 + 2 * i) * mult                   // 4d4, 6d4, 8d4 (x2)
      PATCH_IF (form = 0) BEGIN
        SET pro = (i = 2) ? ny_pro_breath2 : ny_pro_breath
        SET rng = (i = 2) ? 30 : 15
      END ELSE PATCH_IF (form = 1) BEGIN
        SET pro = ny_pro_tbball
        SET rng = 40
      END ELSE PATCH_IF (form = 2) BEGIN
        SET pro = ny_pro_tbpoolx
        SET rng = 15                                  // spat just ahead
      END ELSE BEGIN
        SET pro = 1                                   // no projectile
        SET rng = 30
      END
      LPF NY#ADD_SPL_HEADER INT_VAR location = 4 target = 4 range = rng level = lvl casting_time = 1 projectile = pro STR_VAR icon = EVAL ~%icon_b%~ RET h = header END
      // used: every breath ability is removed and the breath recharges
      // (state: the global script gives the choice again when it ends),
      // with a message at the end
      LPF NY#TB_REMOVE_INNATES INT_VAR h END
      LPF ADD_SPELL_EFFECT INT_VAR header = h opcode = 328 target = 1 timing = 0 duration = (cd * ny_round) parameter2 = $ny_state(~BRCD~) special = 1 END
      LPF ADD_SPELL_EFFECT INT_VAR header = h opcode = 139 target = 1 timing = 4 duration = (cd * ny_round) parameter1 = ny_str_breath_ready END
      PATCH_IF (form = 3) BEGIN
        // the animated breath rises where the disciple breathes, for 1 turn
        LPF ADD_SPELL_EFFECT INT_VAR header = h opcode = 174 target = 1 timing = 1 STR_VAR resource = ~NY#BDBRE~ END
        LPF ADD_SPELL_EFFECT INT_VAR header = h opcode = 67  target = 1 timing = 0 duration = ny_turn STR_VAR resource = ~NY#ABRM~ END
      END ELSE PATCH_IF (form = 2) BEGIN
        // the pool, where the explosion lands; the disciple is not hit by
        // his own pool (this immunity also blocks the caster's effects of
        // the pool spell at each new pulse)
        LPF ADD_SPELL_EFFECT INT_VAR header = h opcode = 206 target = 1 timing = 0 duration = ny_turn parameter1 = "-1" STR_VAR resource = EVAL ~%sub%%i%~ END
        LPF ADD_SPELL_EFFECT INT_VAR header = h opcode = 148 target = 1 timing = 1 parameter2 = 1 STR_VAR resource = EVAL ~%sub%%i%~ END
      END ELSE BEGIN
        // the disciple is not hit by his own breath (the line starts on him)
        LPF ADD_SPELL_EFFECT INT_VAR header = h opcode = 206 target = 1 timing = 0 duration = 2 parameter1 = "-1" STR_VAR resource = EVAL ~%resref%~ END
        LPF NY#TB_DAMAGE INT_VAR h dice line = (form = 0) acid END
      END
    END
END

ACTION_FOR_EACH m IN N X BEGIN
  OUTER_SET mult = (~%m%~ STRING_EQUAL ~X~) ? 2 : 1
  OUTER_SET less = (mult = 2) ? 2 : 0                 // Breath Mastery: 2 rounds shorter
  ACTION_FOR_EACH a IN 0 1 BEGIN
    // Breath Weapon alone: the line
    LAF NY#TB_SPELL INT_VAR form = 0 mult acid = a cd = (10 - less) name = ny_str_breath desc = ny_str_breath_d
                    STR_VAR resref = EVAL ~NY#TBA%m%%a%~ icon_b = ~NY#BDBRI~ icon_c = ~NY#BDBRC~ END
    // Meta-breath: the four forms...
    LAF NY#TB_SPELL INT_VAR form = 0 mult acid = a cd = (6 - less)  name = ny_str_bline desc = ny_str_bline_d
                    STR_VAR resref = EVAL ~NY#TBL%m%%a%~ icon_b = ~NY#BDBRI~ icon_c = ~NY#BDBRC~ END
    LAF NY#TB_SPELL INT_VAR form = 1 mult acid = a cd = (10 - less) name = ny_str_bball desc = ny_str_bball_d
                    STR_VAR resref = EVAL ~NY#TBB%m%%a%~ icon_b = ~NY#BDBBB~ icon_c = ~NY#BDBBC~ END
    LAF NY#TB_SPELL INT_VAR form = 2 mult acid = a cd = (8 - less)  name = ny_str_bpool desc = ny_str_bpool_d
                    STR_VAR resref = EVAL ~NY#TBP%m%%a%~ sub = EVAL ~NY#TQ%m%%a%~ icon_b = ~NY#PBRB~ icon_c = ~NY#PBRC~ END
    LAF NY#TB_SPELL INT_VAR form = 3 mult acid = a cd = (12 - less) name = ny_str_banim desc = ny_str_banim_d
                    STR_VAR resref = EVAL ~NY#TBS%m%%a%~ icon_b = ~NY#ABRB~ icon_c = ~NY#ABRC~ END
    // ... and their menu (opcode 214; type 3: cast at once, no memorisation)
<<<<<<<< .../ny-inline/ny#tbm.2da
2DA V1.0
****
            ResRef     Type
LINE        NY#TBL%m%%a%   3
BALL        NY#TBB%m%%a%   3
POOL        NY#TBP%m%%a%   3
ANIM        NY#TBS%m%%a%   3
>>>>>>>>
    COPY ~.../ny-inline/ny#tbm.2da~ ~override/NY#TBM%m%%a%.2da~ EVALUATE_BUFFER
    CREATE ~SPL~ ~NY#TBM%m%%a%~
      LPF NY#SPL_BASE INT_VAR name = ny_str_breath desc = ny_str_breath_d type = 4 level = 1 STR_VAR icon = ~NY#BDBRC~ END
      LPF NY#ADD_SPL_HEADER INT_VAR location = 4 target = 5 range = 1 level = 1 casting_time = 0 STR_VAR icon = ~NY#BDBRI~ RET h = header END
      LPF ADD_SPELL_EFFECT INT_VAR header = h opcode = 214 target = 1 timing = 1 parameter2 = 0 STR_VAR resource = EVAL ~NY#TBM%m%%a%~ END
  END
END


// ---------------------------------------------------------------------------
// Choice of the breath ability: candidates NY#KB<l>, one second apart, most
// specific first. Conditions: Meta-breath for the menu (Breath Weapon
// otherwise), Breath Mastery for X, Acid Mastery for a = 1.
// ---------------------------------------------------------------------------
ACTION_DEFINE_ASSOCIATIVE_ARRAY ny_breath_cand BEGIN
  a => NY#TBMX1  b => NY#TBMX0  c => NY#TBMN1  d => NY#TBMN0
  e => NY#TBAX1  f => NY#TBAX0  g => NY#TBAN1  h => NY#TBAN0
END

OUTER_SET k = 0
ACTION_FOR_EACH l IN a b c d e f g h BEGIN
  OUTER_SET k += 1
  OUTER_SPRINT innate $ny_breath_cand(~%l%~)
  OUTER_SET c1 = (k <= 4) ? $ny_has(~MBR~) : $ny_has(~BRW~)
  OUTER_SET c2 = "-1"
  OUTER_SET c3 = "-1"
  ACTION_IF (~%innate%~ STRING_MATCHES_REGEXP ~NY#TB.X.~ = 0) BEGIN
    OUTER_SET c2 = $ny_has(~BMS~)
  END
  ACTION_IF (~%innate%~ STRING_MATCHES_REGEXP ~NY#TB..1~ = 0) BEGIN
    ACTION_IF (c2 < 0) BEGIN OUTER_SET c2 = $ny_has(~AMS~) END ELSE BEGIN OUTER_SET c3 = $ny_has(~AMS~) END
  END

  LAF NY#T_SELF_SPL STR_VAR resref = EVAL ~NY#KB%l%F~ END
  COPY_EXISTING ~NY#KB%l%F.spl~ ~override~
    // nothing while the breath recharges
    LPF ADD_SPELL_EFFECT INT_VAR header = 1 opcode = 324 target = 1 duration = 1 parameter2 = $ny_has(~BRCD~) STR_VAR resource = EVAL ~NY#KB%l%F~ END
    SET j = 0
    PATCH_FOR_EACH n IN a b c d e f g h BEGIN
      SET j += 1
      PATCH_IF (j > k) BEGIN
        LPF ADD_SPELL_EFFECT INT_VAR header = 1 opcode = 206 target = 1 timing = 0 duration = 15 parameter1 = "-1" STR_VAR resource = EVAL ~NY#KB%n%~ END
      END
    END
    LPF NY#TB_REMOVE_INNATES END
    LPF ADD_SPELL_EFFECT INT_VAR header = 1 opcode = 171 target = 1 timing = 1 STR_VAR resource = EVAL ~%innate%~ END

  LAF NY#T_CANDIDATE INT_VAR r1 = c1 r2 = c2 r3 = c3 STR_VAR entry = EVAL ~NY#KB%l%~ final = EVAL ~NY#KB%l%F~ END
END

LAF NY#T_SELF_SPL STR_VAR resref = ~NY#KBRT~ END
COPY_EXISTING ~NY#KBRT.spl~ ~override~
  // choice in progress: the global script does not cast it again meanwhile
  LPF ADD_SPELL_EFFECT INT_VAR header = 1 opcode = 328 target = 1 timing = 0 duration = 10 parameter2 = $ny_state(~BRCH~) special = 1 END
  SET j = 0
  PATCH_FOR_EACH l IN a b c d e f g h BEGIN
    SET j += 1
    LPF ADD_SPELL_EFFECT INT_VAR header = 1 opcode = 146 target = 1 timing = 4 duration = j parameter2 = 1 STR_VAR resource = EVAL ~NY#KB%l%~ END
  END

// Breath transformations: pending recharges cancelled, choice at once
LAF NY#T_SELF_SPL STR_VAR resref = ~NY#KBRF~ END
COPY_EXISTING ~NY#KBRF.spl~ ~override~
  PATCH_FOR_EACH f IN A L B P S BEGIN
    PATCH_FOR_EACH m IN N X BEGIN
      PATCH_FOR_EACH a IN 0 1 BEGIN
        LPF ADD_SPELL_EFFECT INT_VAR header = 1 opcode = 321 target = 1 timing = 1 STR_VAR resource = EVAL ~NY#TB%f%%m%%a%~ END
      END
    END
  END
  LPF ADD_SPELL_EFFECT INT_VAR header = 1 opcode = 146 target = 1 timing = 1 parameter2 = 1 STR_VAR resource = ~NY#KBRT~ END
