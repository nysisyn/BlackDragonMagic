// Black Dragon Disciple: claws in the fist slot
// The engine does not save the fist slot: after a load, the default fist
// is back. For each party member of the kit (KIT.IDS value filled in at
// install time) who carries none of the claws NY#BDCL1..6, put the claws
// of their stage back (stages: levels 1, 4, 8, 12, 16, 20), and reset the
// stage memory NY#BDDF1..6 so the block below selects the fist again: this
// refreshes the weapon button (icon) and the 2 attacks per round.
// Continue() lets the rest of the script run.
// Method of the Arcane Fist kit (global script restoring the fists).

IF
  Kit(Player1,%ny_kit_value%)
  LevelGT(Player1,19)
  !HasItem("NY#BDCL1",Player1)
  !HasItem("NY#BDCL2",Player1)
  !HasItem("NY#BDCL3",Player1)
  !HasItem("NY#BDCL4",Player1)
  !HasItem("NY#BDCL5",Player1)
  !HasItem("NY#BDCL6",Player1)
THEN
  RESPONSE #100
    ApplySpellRES("NY#BDZ6",Player1)
    SetGlobal("NY#BDDR1","GLOBAL",0)
    SetGlobal("NY#BDDF1","GLOBAL",0)
    Continue()
END

IF
  Kit(Player1,%ny_kit_value%)
  LevelGT(Player1,15)
  LevelLT(Player1,20)
  !HasItem("NY#BDCL1",Player1)
  !HasItem("NY#BDCL2",Player1)
  !HasItem("NY#BDCL3",Player1)
  !HasItem("NY#BDCL4",Player1)
  !HasItem("NY#BDCL5",Player1)
  !HasItem("NY#BDCL6",Player1)
THEN
  RESPONSE #100
    ApplySpellRES("NY#BDZ5",Player1)
    SetGlobal("NY#BDDR1","GLOBAL",0)
    SetGlobal("NY#BDDF1","GLOBAL",0)
    Continue()
END

