// Retries: the one-off selection above can be lost, for instance during a
// cutscene (start of Throne of Bhaal). While a disciple fights with his
// claws and has fewer than 2 attacks per round, select again, at most once
// per round and 5 times (NY#BDDR1..6, reset at each new stage). The limit
// keeps the script from interrupting the player for ever when an effect
// lowers the attacks (Slow...).

IF
  Kit(Player1,%ny_kit_value%)
  OR(6)
  HasItemEquipedReal("NY#BDCL1",Player1)
  HasItemEquipedReal("NY#BDCL2",Player1)
  HasItemEquipedReal("NY#BDCL3",Player1)
  HasItemEquipedReal("NY#BDCL4",Player1)
  HasItemEquipedReal("NY#BDCL5",Player1)
  HasItemEquipedReal("NY#BDCL6",Player1)
  CheckStatLT(Player1,2,NUMBEROFATTACKS)
  GlobalLT("NY#BDDR1","GLOBAL",5)
  !GlobalTimerNotExpired("NY#BDDT1","GLOBAL")
THEN
  RESPONSE #100
    IncrementGlobal("NY#BDDR1","GLOBAL",1)
    SetGlobalTimer("NY#BDDT1","GLOBAL",6)
    ActionOverride(Player1,SelectWeaponAbility(SLOT_WEAPON1,0))
    ActionOverride(Player1,SelectWeaponAbility(SLOT_WEAPON0,0))
    Continue()
END

IF
  Kit(Player2,%ny_kit_value%)
  OR(6)
  HasItemEquipedReal("NY#BDCL1",Player2)
  HasItemEquipedReal("NY#BDCL2",Player2)
  HasItemEquipedReal("NY#BDCL3",Player2)
  HasItemEquipedReal("NY#BDCL4",Player2)
  HasItemEquipedReal("NY#BDCL5",Player2)
  HasItemEquipedReal("NY#BDCL6",Player2)
  CheckStatLT(Player2,2,NUMBEROFATTACKS)
  GlobalLT("NY#BDDR2","GLOBAL",5)
