// New stage: claws not used yet (stage stored per party slot in NY#BDDF1..6).
// The retry counter NY#BDDR1..6 is reset here.

IF
  Kit(Player1,%ny_kit_value%)
  HasItemEquipedReal("NY#BDCL1",Player1)
  !Global("NY#BDDF1","GLOBAL",1)
THEN
  RESPONSE #100
    SetGlobal("NY#BDDF1","GLOBAL",1)
    SetGlobal("NY#BDDR1","GLOBAL",0)
    ActionOverride(Player1,SelectWeaponAbility(SLOT_WEAPON1,0))
    ActionOverride(Player1,SelectWeaponAbility(SLOT_WEAPON0,0))
    Continue()
END

