// Claws of a new stage (level up): the engine only applies the equipped
// effects of the fist slot (2 attacks per round) when the fist is selected
// again, as when a weapon is put on then taken off. For a disciple fighting
// unarmed with claws he has not used yet (stage stored per party slot in
// NY#BDDF1..6), select a weapon slot then the fist again.
// The retry counter NY#BDDR1..6 is reset here and when the claws are put
// back after a load (see the retries at the end).

IF
  Kit(Player1,%ny_kit_value%)
  HasItemEquipedReal("NY#BDCL1",Player1)
  !Global("NY#BDDF1","GLOBAL",1)
THEN
  RESPONSE #100
    SetGlobal("NY#BDDF1","GLOBAL",1)
    SetGlobal("NY#BDDR1","GLOBAL",0)
    ActionOverride(Player1,SelectWeaponAbility(SLOT_WEAPON0,0))
    ActionOverride(Player1,SelectWeaponAbility(SLOT_FIST,0))
    Continue()
END

IF
  Kit(Player1,%ny_kit_value%)
  HasItemEquipedReal("NY#BDCL2",Player1)
  !Global("NY#BDDF1","GLOBAL",2)
THEN
  RESPONSE #100
    SetGlobal("NY#BDDF1","GLOBAL",2)
    SetGlobal("NY#BDDR1","GLOBAL",0)
    ActionOverride(Player1,SelectWeaponAbility(SLOT_WEAPON0,0))
    ActionOverride(Player1,SelectWeaponAbility(SLOT_FIST,0))
    Continue()
END

IF
  Kit(Player1,%ny_kit_value%)
  HasItemEquipedReal("NY#BDCL3",Player1)
  !Global("NY#BDDF1","GLOBAL",3)
THEN
  RESPONSE #100
    SetGlobal("NY#BDDF1","GLOBAL",3)
    SetGlobal("NY#BDDR1","GLOBAL",0)
    ActionOverride(Player1,SelectWeaponAbility(SLOT_WEAPON0,0))
    ActionOverride(Player1,SelectWeaponAbility(SLOT_FIST,0))
    Continue()
END

IF
  Kit(Player1,%ny_kit_value%)
  HasItemEquipedReal("NY#BDCL4",Player1)
  !Global("NY#BDDF1","GLOBAL",4)
THEN
  RESPONSE #100
    SetGlobal("NY#BDDF1","GLOBAL",4)
