// Black Dragon Disciple: claws in the two weapon slots
// The claws are created in SLOT_WEAPON0 and SLOT_WEAPON1 by the CLAB, and
// these slots are saved. This script is only a safety net and a refresh:
// - if a party member of the kit (KIT.IDS value filled in at install time)
//   carries none of the claws NY#BDCL1..6, give back the claws of his stage
//   (stages: levels 1, 4, 8, 12, 16, 20);
// - at each new stage, select the other weapon slot then the first one, so
//   the engine applies the new claws' equipped effects (2 attacks per round);
// - retries if he has fewer than 2 attacks per round with his claws.
// Continue() lets the rest of the script run.

IF
  Kit(Player1,%ny_kit_value%)
  LevelGT(Player1,19)
  !HasItem("NY#BDCL1",Player1)
  !HasItem("NY#BDCL2",Player1)
  !HasItem("NY#BDCL3",Player1)
  !HasItem("NY#BDCL4",Player1)
  !HasItem("NY#BDCL5",Player1)
  !HasItem("NY#BDCL6",Player1)
THEN
  RESPONSE #100
    ApplySpellRES("NY#BDZ6",Player1)
    SetGlobal("NY#BDDR1","GLOBAL",0)
    SetGlobal("NY#BDDF1","GLOBAL",0)
    Continue()
END

IF
  Kit(Player1,%ny_kit_value%)
  LevelGT(Player1,15)
  LevelLT(Player1,20)
  !HasItem("NY#BDCL1",Player1)
  !HasItem("NY#BDCL2",Player1)
  !HasItem("NY#BDCL3",Player1)
  !HasItem("NY#BDCL4",Player1)
  !HasItem("NY#BDCL5",Player1)
  !HasItem("NY#BDCL6",Player1)
THEN
  RESPONSE #100
    ApplySpellRES("NY#BDZ5",Player1)
    SetGlobal("NY#BDDR1","GLOBAL",0)
    SetGlobal("NY#BDDF1","GLOBAL",0)
    Continue()
END

