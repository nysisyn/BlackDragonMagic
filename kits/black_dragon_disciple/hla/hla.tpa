/////////////////////////////////////////////////////////////////////////////
// Black Dragon Disciple - high-level abilities (Throne of Bhaal, BG2:EE and
// EET only)
//
// The kit gets its own HLA table (LUNYB.2DA, abbreviation NYB in
// LUABBR.2DA) instead of the sorcerer's one (LUSO1.2DA for the Dragon
// Disciple). Kept from the sorcerer: the extra spells of levels 6, 7 and 8.
// Removed: Energy Blades, Improved Alacrity, Dragon's Breath, Summon
// Planetar, Summon Dark Planetar and Comet.
// New (innate, once per day, each pick gives one more use, except Black
// Dragon Magic Mastery, picked once):
//   NY#BDBL  Breath Doom: the game's Dragon's Breath (SPWI922), acid instead
//            of fire, with the explosion and sound of the black dragon's own
//            breath (SPIN691: projectile GREEHIT, sound BLACK04) instead of
//            the red dragon head visual. Icons: the former Black Dragon
//            Breathball ones (SPWI922 in acid yellow).
//   NY#THCA  Call Ancestor: the game's Summon Planetar (SPWI924) calling
//            NY#TANC, the Half Black Dragon Spirit. Placeholder: the
//            planetar renamed, immune to acid (see TODO).
//   NY#THBM  Bonemelt: 4d4 acid per round for 10 rounds on one creature;
//            skeletons are destroyed. Icons: the Bonemelt spell's.
//   NY#THMS  Black Dragon Magic Mastery (AP_, applied when picked): learns
//            Creeping Doom, Summon Reptile and Swampy Lake
//            (transformations/granted_spells.tpa).
/////////////////////////////////////////////////////////////////////////////

OUTER_SET ny_str_bdoom    = RESOLVE_STR_REF (@300)
OUTER_SET ny_str_bdoom_d  = RESOLVE_STR_REF (@301)
OUTER_SET ny_str_ancestor   = RESOLVE_STR_REF (@302)
OUTER_SET ny_str_ancestor_d = RESOLVE_STR_REF (@303)
OUTER_SET ny_str_hbonemelt   = RESOLVE_STR_REF (@304)
OUTER_SET ny_str_hbonemelt_d = RESOLVE_STR_REF (@305)
OUTER_SET ny_str_hmastery    = RESOLVE_STR_REF (@306)
OUTER_SET ny_str_hmastery_d  = RESOLVE_STR_REF (@307)
OUTER_SET ny_str_spirit      = RESOLVE_STR_REF (@270)

// Icons
COPY ~%MOD_FOLDER%/kits/black_dragon_disciple/hla/bam/ny#bdblb.bam~ ~override~
     ~%MOD_FOLDER%/kits/black_dragon_disciple/hla/bam/ny#bdblc.bam~ ~override~
     ~%MOD_FOLDER%/spells/bonemelt/bam/ny#bmltb.bam~ ~override~
     ~%MOD_FOLDER%/spells/bonemelt/bam/ny#bmltc.bam~ ~override~
LAF NY#ICON_B_FROM_C STR_VAR b = ~NY#BDBLB~ c = ~NY#BDBLC~ END   // Remastered Spell Icons
LAF NY#ICON_B_FROM_C STR_VAR b = ~NY#BMLTB~ c = ~NY#BMLTC~ END

// Turns a copied spell into an innate ability (type 4, every header
// "innate") with a new name, description and icons.
DEFINE_PATCH_FUNCTION NY#HLA_INNATE
  INT_VAR name = 0 desc = 0
  STR_VAR icon_b = ~~ icon_c = ~~
BEGIN
  WRITE_LONG  0x08 name
  WRITE_LONG  0x0c name
  WRITE_LONG  0x50 desc
  WRITE_LONG  0x54 desc
  WRITE_SHORT 0x1c 4                          // innate
  WRITE_LONG  0x34 1                          // level
  WRITE_ASCIIE 0x3a ~%icon_c%~ #8
  READ_LONG  0x64 ho
  READ_SHORT 0x68 hn
  FOR (h = 0; h < hn; ++h) BEGIN
    WRITE_BYTE   (ho + h * 0x28 + 0x02) 4      // location: innate
    WRITE_ASCIIE (ho + h * 0x28 + 0x04) ~%icon_b%~ #8
  END
END


// ---------------------------------------------------------------------------
// Breath Doom: Dragon's Breath in acid
// ---------------------------------------------------------------------------
// Projectile and sound of the black dragon's breath (SPIN691)
COPY_EXISTING ~spin691.spl~ ~override~
  READ_LONG  0x64 ho
  READ_SHORT (ho + 0x26) ny_bdbl_pro
  READ_LONG  0x6a eo
  READ_SHORT (ho + 0x1e) en                      // effects of the (only) header
  READ_SHORT (ho + 0x20) ei
  SPRINT ny_bdbl_snd ~BLACK04~
  FOR (e = ei; e < ei + en; ++e) BEGIN
    READ_SHORT (eo + e * 0x30) op
    PATCH_IF (op = 174) BEGIN READ_ASCII (eo + e * 0x30 + 0x14) ny_bdbl_snd (8) NULL END
  END
BUT_ONLY

COPY_EXISTING ~spwi922.spl~ ~override/NY#BDBL.spl~
  LPF NY#HLA_INNATE INT_VAR name = ny_str_bdoom desc = ny_str_bdoom_d STR_VAR icon_b = ~NY#BDBLB~ icon_c = ~NY#BDBLC~ END
  LPF ALTER_SPELL_EFFECT INT_VAR match_opcode = 12 match_parameter2 = 0x80000 parameter2 = 0x10000 END   // fire -> acid
  LPF DELETE_SPELL_EFFECT INT_VAR opcode_to_delete = 215 END                       // red dragon head
  LPF ALTER_SPELL_EFFECT INT_VAR match_opcode = 174 STR_VAR resource = EVAL ~%ny_bdbl_snd%~ END
  READ_LONG  0x64 ho
  READ_SHORT 0x68 hn
  FOR (h = 0; h < hn; ++h) BEGIN
    WRITE_SHORT (ho + h * 0x28 + 0x26) ny_bdbl_pro                                  // GREEHIT
  END


// ---------------------------------------------------------------------------
// Call Ancestor: Summon Planetar calling the Half Black Dragon Spirit
// ---------------------------------------------------------------------------
// The planetar comes from opcode 67 in the spell or, as in BG2:EE, from
// opcode 177 and its EFF (SPPLAN2.EFF: opcode 67, PLANEVIL).
OUTER_SPRINT ny_planetar ~~
OUTER_SPRINT ny_planetar_eff ~~
COPY_EXISTING ~spwi924.spl~ ~override~
  READ_LONG  0x6a eo
  SET en = (BUFFER_LENGTH - eo) / 0x30            // every effect, global or not
  FOR (e = 0; e < en; ++e) BEGIN
    READ_SHORT (eo + e * 0x30) op
    PATCH_IF (op = 67) BEGIN READ_ASCII (eo + e * 0x30 + 0x14) ny_planetar (8) NULL END
    PATCH_IF (op = 177) BEGIN READ_ASCII (eo + e * 0x30 + 0x14) ny_planetar_eff (8) NULL END
  END
BUT_ONLY
ACTION_IF (~%ny_planetar%~ STRING_EQUAL ~~) AND (~%ny_planetar_eff%~ STRING_COMPARE ~~) BEGIN
  ACTION_IF FILE_EXISTS_IN_GAME ~%ny_planetar_eff%.eff~ BEGIN
    COPY_EXISTING ~%ny_planetar_eff%.eff~ ~override~
      READ_LONG 0x10 op
      PATCH_IF (op = 67) BEGIN READ_ASCII 0x30 ny_planetar (8) NULL END
    BUT_ONLY
  END
END

ACTION_IF (~%ny_planetar%~ STRING_COMPARE ~~) AND FILE_EXISTS_IN_GAME ~%ny_planetar%.cre~ BEGIN
  COPY_EXISTING ~%ny_planetar%.cre~ ~override/NY#TANC.cre~
    WRITE_LONG 0x08 ny_str_spirit
    WRITE_LONG 0x0c ny_str_spirit
    WRITE_BYTE 0x5c 100                          // immune to acid
  // the EFF of opcode 177, calling the spirit
  ACTION_IF (~%ny_planetar_eff%~ STRING_COMPARE ~~) BEGIN
    COPY_EXISTING ~%ny_planetar_eff%.eff~ ~override/NY#TANE.eff~
      WRITE_ASCII 0x30 ~NY#TANC~ #8
  END
  COPY_EXISTING ~spwi924.spl~ ~override/NY#THCA.spl~
    READ_ASCII 0x3a ic (8) NULL                 // the planetar's own icons
    READ_LONG  0x64 ho
    READ_ASCII (ho + 0x04) ib (8) NULL
    LPF NY#HLA_INNATE INT_VAR name = ny_str_ancestor desc = ny_str_ancestor_d STR_VAR icon_b = EVAL ~%ib%~ icon_c = EVAL ~%ic%~ END
    LPF ALTER_SPELL_EFFECT INT_VAR match_opcode = 67  STR_VAR resource = ~NY#TANC~ END
    LPF ALTER_SPELL_EFFECT INT_VAR match_opcode = 177 STR_VAR resource = ~NY#TANE~ END
    WRITE_LONG 0x1e 0                           // no alignment restriction
END ELSE BEGIN
  PRINT ~Black Dragon Disciple: Summon Planetar (SPWI924) summons no creature (opcode 67, or 177 and its EFF), Call Ancestor not built.~
END


// ---------------------------------------------------------------------------
// Bonemelt: 4d4 acid per round for 10 rounds (opcode 272, EFF NY#THBE);
// skeletons are destroyed (NY#THSK)
// ---------------------------------------------------------------------------
LAF NY#CREATE_EFF INT_VAR opcode = 12 target = 1 parameter2 = 0x10000 dicenumber = 4 dicesize = 4 STR_VAR eff = ~NY#THBE~ END

OUTER_SET ny_ids_skeleton = IDS_OF_SYMBOL (~race~ ~SKELETON~)
LAF NY#SPLPROT_ROW STR_VAR label = ~NY#RACE!=SKELETON~ stat = ~0x10c~ value = EVAL ~%ny_ids_skeleton%~ relation = ~5~ RET ny_prot_not_skeleton = row END

CREATE ~SPL~ ~NY#THSK~
  LPF NY#SPL_BASE INT_VAR type = 4 level = 1 flags = 0x400 END
  LPF NY#ADD_SPL_HEADER INT_VAR location = 4 target = 1 range = 1000 level = 1 casting_time = 0 RET h = header END
  LPF ADD_SPELL_EFFECT INT_VAR header = h opcode = 324 target = 2 duration = 1 parameter2 = ny_prot_not_skeleton STR_VAR resource = ~NY#THSK~ END
  LPF ADD_SPELL_EFFECT INT_VAR header = h opcode = 13  target = 2 timing = 1 parameter1 = 0 parameter2 = 0 END

CREATE ~SPL~ ~NY#THBM~
  LPF NY#SPL_BASE INT_VAR name = ny_str_hbonemelt desc = ny_str_hbonemelt_d type = 4 level = 1 school = 8 graphics = 10 STR_VAR icon = ~NY#BMLTC~ END
  LPF NY#ADD_SPL_HEADER INT_VAR location = 4 target = 1 range = 30 level = 1 casting_time = 1 STR_VAR icon = ~NY#BMLTB~ RET h = header END
  LPF ADD_SPELL_EFFECT INT_VAR header = h opcode = 272 target = 2 timing = 0 duration = (10 * ny_round) parameter1 = ny_round parameter2 = 3 resist_dispel = 1 STR_VAR resource = ~NY#THBE~ END
  LPF ADD_SPELL_EFFECT INT_VAR header = h opcode = 215 target = 2 timing = 0 duration = 1 parameter2 = 1 STR_VAR resource = ~SHACID~ END
  LPF ADD_SPELL_EFFECT INT_VAR header = h opcode = 146 target = 2 timing = 1 parameter2 = 1 STR_VAR resource = ~NY#THSK~ END


// ---------------------------------------------------------------------------
// Black Dragon Magic Mastery: learns the spells of $ny_hms
// ---------------------------------------------------------------------------
CREATE ~SPL~ ~NY#THMS~
  LPF NY#SPL_BASE INT_VAR name = ny_str_hmastery desc = ny_str_hmastery_d type = 4 level = 1 STR_VAR icon = ~NY#TGBDC~ END
  LPF NY#ADD_SPL_HEADER INT_VAR location = 4 target = 5 range = 1 level = 1 casting_time = 0 STR_VAR icon = ~NY#TGBDB~ RET h = header END
  FOR (i = 0; i < ny_hms_n; ++i) BEGIN
    SPRINT r $ny_hms(~%i%~)
    LPF ADD_SPELL_EFFECT INT_VAR header = h opcode = 147 target = 1 timing = 1 STR_VAR resource = EVAL ~%r%~ END
  END


// ---------------------------------------------------------------------------
// HLA table
// ---------------------------------------------------------------------------
COPY ~%MOD_FOLDER%/kits/black_dragon_disciple/2da/lunyb.2da~ ~override~
// without Call Ancestor, its row goes (a row "*" is an empty ability: the
// engine shows none of the table)
ACTION_IF NOT FILE_EXISTS_IN_GAME ~NY#THCA.spl~ BEGIN
  COPY_EXISTING ~lunyb.2da~ ~override~
    REPLACE_TEXTUALLY ~^[0-9]+[ %TAB%]+GA_NY#THCA[^%LNL%%MNL%%WNL%]*[%LNL%%MNL%%WNL%]+~ ~~
END
