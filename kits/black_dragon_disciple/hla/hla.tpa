/////////////////////////////////////////////////////////////////////////////
// Black Dragon Disciple - high-level abilities (Throne of Bhaal, BG2:EE and
// EET only)
//
// The kit gets its own HLA table (LUNYB.2DA, abbreviation NYB in
// LUABBR.2DA) instead of the sorcerer's one (LUSO1.2DA for the Dragon
// Disciple). Kept from the sorcerer: the extra spells of levels 6, 7 and 8
// and Summon Dark Planetar. Removed: Energy Blades, Improved Alacrity,
// Dragon's Breath, Summon Planetar and Comet.
// New, from the abilities of the black dragon Nizidramanii'yt (DRAGBLAC.BCS)
// and innate (once per day, each pick gives one more use; Breathbloom
// can only be picked once):
//   NY#BDBL  Breathbloom: the game's Dragon's Breath (SPWI922), acid instead
//            of fire, with the explosion and sound of the black dragon's own
//            breath (SPIN691: projectile GREEHIT, sound BLACK04) instead of
//            the red dragon head visual. Icons: the former Black Dragon
//            Breathball ones (SPWI922 in acid yellow).
//   NY#BDWB  Wing Buffet: the dragon's Wing Buffet (SPIN695), save vs. Spell
//            at -4 instead of -10 against the 3 seconds of unconsciousness.
//            Icon: the kit's wings.
//   NY#BDIS  Insect Swarm: the dragon's Summon Insects (SPIN689), unchanged
//            (Creeping Doom without casting time).
//   NY#BDPG  Plant Growth: the dragon's Plant Growth (SPIN688); the caster is
//            not affected.
/////////////////////////////////////////////////////////////////////////////

OUTER_SET ny_str_bbloom   = RESOLVE_STR_REF (@80)
OUTER_SET ny_str_bbloom_d = RESOLVE_STR_REF (@81)
OUTER_SET ny_str_wbuff    = RESOLVE_STR_REF (@82)
OUTER_SET ny_str_wbuff_d  = RESOLVE_STR_REF (@83)
OUTER_SET ny_str_insect   = RESOLVE_STR_REF (@84)
OUTER_SET ny_str_insect_d = RESOLVE_STR_REF (@85)
OUTER_SET ny_str_plant    = RESOLVE_STR_REF (@86)
OUTER_SET ny_str_plant_d  = RESOLVE_STR_REF (@87)

// Icons
COPY ~%MOD_FOLDER%/kits/black_dragon_disciple/hla/bam/ny#bdblb.bam~ ~override~
     ~%MOD_FOLDER%/kits/black_dragon_disciple/hla/bam/ny#bdblc.bam~ ~override~
LAF NY#ICON_B_FROM_C STR_VAR b = ~NY#BDBLB~ c = ~NY#BDBLC~ END   // Remastered Spell Icons

// Projectile and sound of the black dragon's breath (SPIN691)
COPY_EXISTING ~spin691.spl~ ~override~
  READ_LONG  0x64 ho
  READ_SHORT (ho + 0x26) ny_bdbl_pro
  READ_LONG  0x6a eo
  READ_SHORT (ho + 0x1e) en                      // effects of the (only) header
  READ_SHORT (ho + 0x20) ei
  SPRINT ny_bdbl_snd ~BLACK04~
  FOR (e = ei; e < ei + en; ++e) BEGIN
    READ_SHORT (eo + e * 0x30) op
    PATCH_IF (op = 174) BEGIN READ_ASCII (eo + e * 0x30 + 0x14) ny_bdbl_snd (8) NULL END
  END
BUT_ONLY

// Turns a copied spell into an innate ability (type 4, every header
// "innate") with a new name, description and icons.
DEFINE_PATCH_FUNCTION NY#HLA_INNATE
  INT_VAR name = 0 desc = 0
  STR_VAR icon_b = ~~ icon_c = ~~
BEGIN
  WRITE_LONG  0x08 name
  WRITE_LONG  0x0c name
  WRITE_LONG  0x50 desc
  WRITE_LONG  0x54 desc
  WRITE_SHORT 0x1c 4                          // innate
  WRITE_LONG  0x34 1                          // level
  WRITE_ASCIIE 0x3a ~%icon_c%~ #8
  READ_LONG  0x64 ho
  READ_SHORT 0x68 hn
  FOR (h = 0; h < hn; ++h) BEGIN
    WRITE_BYTE   (ho + h * 0x28 + 0x02) 4      // location: innate
    WRITE_ASCIIE (ho + h * 0x28 + 0x04) ~%icon_b%~ #8
  END
END

// Breathbloom: Dragon's Breath in acid
COPY_EXISTING ~spwi922.spl~ ~override/NY#BDBL.spl~
  LPF NY#HLA_INNATE INT_VAR name = ny_str_bbloom desc = ny_str_bbloom_d STR_VAR icon_b = ~NY#BDBLB~ icon_c = ~NY#BDBLC~ END
  LPF ALTER_SPELL_EFFECT INT_VAR match_opcode = 12 match_parameter2 = 0x80000 parameter2 = 0x10000 END   // fire -> acid
  LPF DELETE_SPELL_EFFECT INT_VAR opcode_to_delete = 215 END                       // red dragon head
  LPF ALTER_SPELL_EFFECT INT_VAR match_opcode = 174 STR_VAR resource = EVAL ~%ny_bdbl_snd%~ END
  READ_LONG  0x64 ho
  READ_SHORT 0x68 hn
  FOR (h = 0; h < hn; ++h) BEGIN
    WRITE_SHORT (ho + h * 0x28 + 0x26) ny_bdbl_pro                                  // GREEHIT
  END

// Wing Buffet
COPY_EXISTING ~spin695.spl~ ~override/NY#BDWB.spl~
  LPF NY#HLA_INNATE INT_VAR name = ny_str_wbuff desc = ny_str_wbuff_d STR_VAR icon_b = EVAL ~%ny_icon_wings%~ icon_c = EVAL ~%ny_icon_wings%~ END
  LPF ALTER_SPELL_EFFECT INT_VAR match_opcode = 39 savebonus = "-4" END
  // centred on the Black Dragon Disciple (the dragon aims it at a creature)
  READ_LONG  0x64 ho
  READ_SHORT 0x68 hn
  FOR (h = 0; h < hn; ++h) BEGIN
    WRITE_BYTE  (ho + h * 0x28 + 0x0c) 5         // target: caster
    WRITE_SHORT (ho + h * 0x28 + 0x0e) 0         // range
  END

// Insect Swarm
COPY_EXISTING ~spin689.spl~ ~override/NY#BDIS.spl~
  LPF NY#HLA_INNATE INT_VAR name = ny_str_insect desc = ny_str_insect_d STR_VAR icon_b = ~SPPR717B~ icon_c = ~SPPR717C~ END

// Plant Growth
COPY_EXISTING ~spin688.spl~ ~override/NY#BDPG.spl~
  LPF NY#HLA_INNATE INT_VAR name = ny_str_plant desc = ny_str_plant_d STR_VAR icon_b = ~SPPR105B~ icon_c = ~SPPR105C~ END
  // the Black Dragon Disciple is not caught by his own plants (Swamp Stride
  // only knows the game's Entangle, Grease and Web): one round of immunity
  // to this spell, applied to himself at the start of the casting
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 206 target = 1 timing = 0 duration = ny_round parameter1 = "-1" insert_point = 0 STR_VAR resource = ~NY#BDPG~ END

// ---------------------------------------------------------------------------
// Summon Black Dragon Turtle (HLA, innate, once per day)
//
// Animation MDTU from the dragon turtle of Might and Magic VIII: Day of the
// Destroyer (3DO / New World Computing, 2000; sprite sheet ripped by Cyrus
// Annihilator), built with works/dragon_turtle_mm8_source/build_turtle.py:
// monster_icewind type, 5 facings (west side mirrored), green scales
// blackened, swims a little above the ground (flat shadow), falls to the
// ground when it dies. Animation id: first free one from 0xEC50.
//   NY#DTUR   the turtle (ally, CONTROLLED), from the summoned wyvern: 220 HP,
//             AC -3, THAC0 1, 2 attacks per round, level 16, saves of a
//             level 16 fighter, immune to acid, fear and poison
//   NY#DTUW   its bite: 4d8+4 piercing, +4 weapon; carries the immunities
//   NY#DTBR   its Acid Steam (innate): line 40 ft. long and 15 ft. wide,
//             12d8 acid, save vs. Breath for half; 3 times per summoning,
//             every 3 rounds at most (script NY#DTUS); NY#DTBRT projectile
//   NY#BDDT   the HLA: 1 turn + 1 round per level
//   NY#BDDTB / NY#BDDTC  icons: placeholder, the turtle reduced
// ---------------------------------------------------------------------------
OUTER_SET ny_str_dtur    = RESOLVE_STR_REF (@88)
OUTER_SET ny_str_dtur_br = RESOLVE_STR_REF (@89)
OUTER_SET ny_str_bddt    = RESOLVE_STR_REF (@90)
OUTER_SET ny_str_bddt_d  = RESOLVE_STR_REF (@91)

COPY ~%MOD_FOLDER%/kits/black_dragon_disciple/hla/bam/ny#bddtb.bam~ ~override~
     ~%MOD_FOLDER%/kits/black_dragon_disciple/hla/bam/ny#bddtc.bam~ ~override~
LAF NY#ICON_B_FROM_C STR_VAR b = ~NY#BDDTB~ c = ~NY#BDDTC~ END   // Remastered Spell Icons

COPY ~%MOD_FOLDER%/kits/black_dragon_disciple/hla/turtle/anim~ ~override~

OUTER_SET ny_dtu_anim = "-1"
OUTER_FOR (id = 0xec50; (id <= 0xecff) AND (ny_dtu_anim < 0); ++id) BEGIN
  LAF NY#HEX4 INT_VAR value = id RET hexstring = hex END
  OUTER_SET used = FILE_EXISTS_IN_GAME ~%hexstring%.ini~
  ACTION_IF (NOT used) BEGIN
    COPY_EXISTING ~animate.ids~ ~override~
      PATCH_IF (INDEX_BUFFER (CASE_INSENSITIVE EVALUATE_REGEXP ~^0x%hexstring%[ %TAB%]~) >= 0) BEGIN
        SET used = 1
      END
    BUT_ONLY
  END
  ACTION_IF (NOT used) BEGIN
    OUTER_SET ny_dtu_anim = id
    OUTER_SPRINT ny_dtu_hex ~%hexstring%~
  END
END
ACTION_IF (ny_dtu_anim < 0) BEGIN
  FAIL ~BlackDragonMagic: no free animation id between 0xEC50 and 0xECFF~
END
COPY ~%MOD_FOLDER%/kits/black_dragon_disciple/hla/turtle/ini/dragon_turtle.ini~ ~override/%ny_dtu_hex%.ini~
ACTION_IF (IDS_OF_SYMBOL (~animate~ ~NY_DRAGON_TURTLE~) < 0) BEGIN
  APPEND ~animate.ids~ ~0x%ny_dtu_hex% NY_DRAGON_TURTLE~
END
PRINT ~Black dragon turtle animation id: 0x%ny_dtu_hex%~

// Acid Steam: line 40 ft. x 15 ft. (the kit's breath wave, wider)
LAF NY#CREATE_LINE_PRO INT_VAR speed = 20 width = 120 trail_delay = 2 STR_VAR new = ~NY#DTBRT~ bam = ~NY#BDWAV~ trail = ~NY#BDWVT~ sound = ~NY#BDBRE~ workspace = EVAL ~%ny_workspace%~ RET ny_pro_dtbr = pro_id END
CREATE ~SPL~ ~NY#DTBR~
  LPF NY#SPL_BASE INT_VAR name = ny_str_dtur_br type = 4 level = 1 flags = 0x400 END
  LPF NY#ADD_SPL_HEADER INT_VAR location = 4 target = 4 range = 40 level = 1 casting_time = 0 projectile = ny_pro_dtbr RET h = header END
  LPF ADD_SPELL_EFFECT INT_VAR header = h opcode = 206 target = 1 timing = 0 duration = 2 parameter1 = "-1" STR_VAR resource = ~NY#DTBR~ END
  LPF ADD_SPELL_EFFECT INT_VAR header = h opcode = 215 target = 2 timing = 0 duration = 1 STR_VAR resource = ~NY#BDWVH~ END
  LPF ADD_SPELL_EFFECT INT_VAR header = h opcode = 12  target = 2 timing = 0 parameter2 = 0x10000 dicenumber = 12 dicesize = 8 savingthrow = 2 special = 0x100 END

COMPILE ~%MOD_FOLDER%/kits/black_dragon_disciple/hla/turtle/baf/ny#dtus.baf~

CREATE ~ITM~ ~NY#DTUW~
  WRITE_LONG  0x08 ny_str_dtur
  WRITE_LONG  0x0c ny_str_dtur
  WRITE_LONG  0x18 0x60                         // not copyable, magical
  WRITE_SHORT 0x1c 0x1c                         // hand-to-hand weapon
  WRITE_LONG  0x60 4                            // +4 weapon
  LPF ADD_ITEM_EQEFFECT INT_VAR opcode = 101 target = 1 timing = 2 parameter2 = 24 END   // panic
  LPF ADD_ITEM_EQEFFECT INT_VAR opcode = 101 target = 1 timing = 2 parameter2 = 23 END   // morale failure
  LPF ADD_ITEM_EQEFFECT INT_VAR opcode = 101 target = 1 timing = 2 parameter2 = 25 END   // poison
  LPF NY#ADD_ITM_HEADER INT_VAR attack_type = 1 id_req = 0 location = 1 target = 1 range = 1 speed = 4
                                thac0 = 0 damage_bonus = 4 dice_sides = 8 dice_thrown = 4 damage_type = 1 flags = 1 END

COPY_EXISTING ~WYVERNSU.cre~ ~override/NY#DTUR.cre~
  WRITE_LONG  0x08 ny_str_dtur
  WRITE_LONG  0x0c ny_str_dtur
  WRITE_LONG  0x14 0                            // no experience when killed
  WRITE_SHORT 0x24 220                          // HP
  WRITE_SHORT 0x26 220
  WRITE_LONG  0x28 ny_dtu_anim
  WRITE_SHORT 0x46 "-3"                         // AC
  WRITE_SHORT 0x48 "-3"
  WRITE_BYTE  0x52 1                            // THAC0
  WRITE_BYTE  0x53 2                            // 2 attacks per round
  // saves of a level 16 fighter: death, wands, polymorph, breath, spells
  WRITE_BYTE  0x54 3
  WRITE_BYTE  0x55 5
  WRITE_BYTE  0x56 4
  WRITE_BYTE  0x57 4
  WRITE_BYTE  0x58 6
  FOR (o = 0x59; o <= 0x63; ++o) BEGIN WRITE_BYTE o 0 END
  WRITE_BYTE  0x5c 100                          // acid
  WRITE_BYTE  0x234 16                          // level
  WRITE_BYTE  0x238 21                          // STR
  WRITE_BYTE  0x239 0
  WRITE_BYTE  0x23a 10                          // INT
  WRITE_BYTE  0x23b 13                          // WIS
  WRITE_BYTE  0x23c 10                          // DEX
  WRITE_BYTE  0x23d 21                          // CON
  WRITE_BYTE  0x23e 12                          // CHA
  WRITE_ASCII 0x248 ~NY#DTUS~ #8                // override script: Acid Steam
  WRITE_ASCII 0x258 ~~ #8                       // no wyvern race script
  WRITE_BYTE  0x270 5                           // CONTROLLED, as summons
  REMOVE_CRE_ITEMS
  ADD_CRE_ITEM ~NY#DTUW~ #0 #0 #0 ~NONE~ ~WEAPON1~ EQUIP

// The HLA: innate, 1 turn + 1 round per level
CREATE ~SPL~ ~NY#BDDT~
  LPF NY#SPL_BASE INT_VAR name = ny_str_bddt desc = ny_str_bddt_d type = 4 level = 1
                          school = 2 graphics = 14 STR_VAR icon = ~NY#BDDTC~ END
  FOR (lvl = 1; lvl <= 50; ++lvl) BEGIN
    LPF NY#ADD_SPL_HEADER INT_VAR location = 4 target = 4 range = 30 level = lvl casting_time = 5 STR_VAR icon = ~NY#BDDTB~ RET h = header END
    LPF ADD_SPELL_EFFECT INT_VAR header = h opcode = 67 target = 1 timing = 0 duration = ((10 + lvl) * ny_round) STR_VAR resource = ~NY#DTUR~ END
  END

// HLA table
COPY ~%MOD_FOLDER%/kits/black_dragon_disciple/2da/lunyb.2da~ ~override~
