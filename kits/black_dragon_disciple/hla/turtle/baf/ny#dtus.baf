// The forced cast (ReallyForceSpellRES) ignores the creature's state, so it
// is only tried while the creature can act (not asleep, unconscious,
// stunned, held, panicked, confused...).
// Black dragon turtle: breathes acid steam at the nearest enemy it sees,
// 3 times per summoning (LOCALS counter) and every 3 rounds at most;
// otherwise it attacks in melee.
IF
  See(NearestEnemyOf(Myself))
  GlobalLT("NY#DTBRN","LOCALS",3)
  !StateCheck(Myself,CD_STATE_NOTVALID)
  !CheckStatGT(Myself,0,HELD)
  !GlobalTimerNotExpired("NY#DTBRT","LOCALS")
THEN
  RESPONSE #100
    IncrementGlobal("NY#DTBRN","LOCALS",1)
    SetGlobalTimer("NY#DTBRT","LOCALS",18)
    ReallyForceSpellRES("NY#DTBR",NearestEnemyOf(Myself))
END

IF
  See(NearestEnemyOf(Myself))
THEN
  RESPONSE #100
    AttackReevaluate(NearestEnemyOf(Myself),15)
END
