// The forced cast (ReallyForceSpellRES) ignores the creature's state, so it
// is only tried while the creature can act (not asleep, unconscious,
// stunned, held, panicked, confused...).
// Black mantidrake: while no enemy is in melee reach, it throws a volley of
// corrosive tail spikes at every enemy around it, once every 2 rounds;
// otherwise it fights in melee.
IF
  See(NearestEnemyOf(Myself))
  !Range(NearestEnemyOf(Myself),4)
  Range(NearestEnemyOf(Myself),20)
  !StateCheck(Myself,CD_STATE_NOTVALID)
  !CheckStatGT(Myself,0,HELD)
  !GlobalTimerNotExpired("NY#MTDVT","LOCALS")
THEN
  RESPONSE #100
    SetGlobalTimer("NY#MTDVT","LOCALS",12)
    ReallyForceSpellRES("NY#MTDV",Myself)
END

IF
  See(NearestEnemyOf(Myself))
THEN
  RESPONSE #100
    AttackReevaluate(NearestEnemyOf(Myself),15)
END
