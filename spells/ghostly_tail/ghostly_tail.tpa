/////////////////////////////////////////////////////////////////////////////
// Ghostly Tail - wizard, level 1, Evocation
//
// Self, casting time 1, 1 round per level (no cap), no save, no magic
// resistance.
// Once per round the tail strikes the nearest enemy in melee reach for 1d4
// cold damage (one target per round).
//
// Built like Acidosis / Fire Shield: opcode 232 on the caster fires the
// strike subspell once per round at the nearest enemy; the subspell uses
// the range-limited projectile NY#MELEE (about 12 ft.), so it only reaches
// an enemy in melee reach. The game's RANGE05 was too short.
//
// Resources
//   SPWIxxx   Ghostly Tail (added through ADD_SPELL as WIZARD_NY_GHOSTLY_TAIL)
//   NY#GTLX   tail strike
//   NY#GTLB   spell icon (ability / memorised), NY#GTLC spellbook icon: the
//             game's Entangle icons recoloured spectral turquoise (Nysi's
//             spectral tail artwork version kept in
//             works/ghostly_tail_artwork_icons)
//   NY#GTLH   hit: Smashing Wave splash (IWDEE) recoloured spectral green
//   NY#GTLD   portrait icon (the spellbook icon reduced), in STATDESC.2DA
/////////////////////////////////////////////////////////////////////////////

OUTER_SET ny_str_gtail   = RESOLVE_STR_REF (@1)
OUTER_SET ny_str_gtail_d = RESOLVE_STR_REF (@2)
OUTER_SET ny_str_gtail_hit = RESOLVE_STR_REF (@3)

COPY ~%MOD_FOLDER%/spells/ghostly_tail/bam/ny#gtlb.bam~ ~override~
     ~%MOD_FOLDER%/spells/ghostly_tail/bam/ny#gtlc.bam~ ~override~
     ~%MOD_FOLDER%/spells/ghostly_tail/bam/ny#gtlh.bam~ ~override~
     ~%MOD_FOLDER%/spells/ghostly_tail/bam/ny#gtld.bam~ ~override~
LAF NY#ADD_STATDESC INT_VAR strref = ny_str_gtail STR_VAR bam = ~NY#GTLD~ RET ny_icon_gtail = index END

LAF NY#MELEE_RANGE_PRO STR_VAR workspace = EVAL ~%ny_workspace%~ RET ny_pro_melee = pro_id END

// Tail strike: 1d4 cold damage, no save, no magic resistance
CREATE ~SPL~ ~NY#GTLX~
  LPF NY#SPL_BASE INT_VAR type = 4 level = 1 flags = 0x400 END
  LPF NY#ADD_SPL_HEADER INT_VAR location = 4 target = 1 range = 1000 level = 1 casting_time = 0 projectile = ny_pro_melee RET h = header END
  LPF ADD_SPELL_EFFECT INT_VAR header = h opcode = 12  target = 2 timing = 0 parameter2 = 0x20000 dicenumber = 1 dicesize = 4 END
  LPF ADD_SPELL_EFFECT INT_VAR header = h opcode = 215 target = 2 timing = 0 duration = 1 parameter2 = 1 STR_VAR resource = ~NY#GTLH~ END
  LPF ADD_SPELL_EFFECT INT_VAR header = h opcode = 139 target = 2 timing = 1 parameter1 = ny_str_gtail_hit END   // combat log

// Main spell, one header per level up to 40 (duration 1 round per level)
CREATE ~SPL~ ~NY#GTLS~
  LPF NY#SPL_BASE INT_VAR name = ny_str_gtail desc = ny_str_gtail_d type = 1 level = 1
                          school = 6 exclusion = 0x200 graphics = 15 STR_VAR icon = ~NY#GTLC~ END
  FOR (lvl = 1; lvl <= 40; ++lvl) BEGIN
    LPF NY#ADD_SPL_HEADER INT_VAR location = 2 target = 5 range = 1 level = lvl casting_time = 1 STR_VAR icon = ~NY#GTLB~ RET h = header END
    // remove a previous casting first (no stacking)
    LPF ADD_SPELL_EFFECT INT_VAR header = h opcode = 321 target = 1 timing = 1 STR_VAR resource = ~NY#GTLS~ END
    // portrait icon for the duration
    LPF ADD_SPELL_EFFECT INT_VAR header = h opcode = 142 target = 1 timing = 0 duration = (lvl * ny_round) parameter2 = ny_icon_gtail resist_dispel = 3 END
    // every round (condition 20 = HPPercentLT(Myself,102), always true,
    // special 102 keeps the effect after it fires and hides the casting
    // glow), strike the nearest enemy. Opcode 232 must stay the last effect.
    LPF ADD_SPELL_EFFECT INT_VAR header = h opcode = 232 target = 1 timing = 0 duration = (lvl * ny_round) parameter1 = 2 parameter2 = 20 special = 102 resist_dispel = 3 STR_VAR resource = ~NY#GTLX~ END
  END

ADD_SPELL ~override/NY#GTLS.spl~ 2 1 ~WIZARD_NY_GHOSTLY_TAIL~
LAF RES_NUM_OF_SPELL_NAME STR_VAR spell_name = ~WIZARD_NY_GHOSTLY_TAIL~ RET ny_tail_res = spell_res END

// self references must point to the final resref
COPY_EXISTING ~%ny_tail_res%.spl~ ~override~
  LPF ALTER_SPELL_EFFECT INT_VAR match_opcode = 321 STR_VAR resource = EVAL ~%ny_tail_res%~ END
