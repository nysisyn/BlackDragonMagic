/////////////////////////////////////////////////////////////////////////////
// Black Dragon Breathball - wizard, level 3, Evocation
//
// Acid Breath damage in a Fireball area (20 ft. radius): 3d8 at 5th level,
// +1d8 at 6, 9, 12, 15 and 18 (max 8d8), save vs. Breath for half. Allies
// in the area are affected, as with Fireball.
//
// Projectile NY#BDBBP: Fireball (FIREBALL.PRO) with
//   - the travelling object of Melf's Acid Arrow (ARROWFLG.PRO: green
//     flame arrow, BAM block 0x100-0x157 and fire sound copied)
//   - the explosion of the game's Black Dragon Breath (SPIN691, projectile
//     GREEHIT.PRO: explosion effect 18, colour 67) instead of the fire
//     explosion (Fireball's VVC and flame ring removed)
//
// Resources
//   SPWIxxx   Black Dragon Breathball (added through ADD_SPELL as
//             WIZARD_NY_BREATHBALL)
//   NY#BDBBP  projectile
//   NY#BDBBB  spell icon (ability / memorised, on a stone plate), NY#BDBBC
//             spellbook icon: the game's SPWI922 icons recoloured in the acid
//             yellow of the kit's breath (Nysi's acid dragon artwork version
//             in works/breathball_artwork_icons, its source in
//             works/breathball_icon_source)
/////////////////////////////////////////////////////////////////////////////

OUTER_SET ny_str_bball   = RESOLVE_STR_REF (@1)
OUTER_SET ny_str_bball_d = RESOLVE_STR_REF (@2)

COPY ~%MOD_FOLDER%/spells/breathball/bam/ny#bdbbb.bam~ ~override~
     ~%MOD_FOLDER%/spells/breathball/bam/ny#bdbbc.bam~ ~override~

// Travelling object of Melf's Acid Arrow: BAM block and fire sound
COPY_EXISTING ~arrowflg.pro~ ~override~
  FOR (o = 0x100; o < 0x158; ++o) BEGIN
    READ_BYTE o v
    SET $ny_arrow(~%o%~) = v
  END
  READ_ASCII 0x10 ny_arrow_sound (8) NULL
BUT_ONLY

// Explosion of the game's Black Dragon Breath
COPY_EXISTING ~greehit.pro~ ~override~
  READ_BYTE 0x217 ny_expl_effect
  READ_BYTE 0x218 ny_expl_color
BUT_ONLY

COPY_EXISTING ~fireball.pro~ ~%ny_workspace%/NY#BDBBP.pro~
  FOR (o = 0x100; o < 0x158; ++o) BEGIN
    WRITE_BYTE o $ny_arrow(~%o%~)
  END
  WRITE_ASCIIE 0x10 ~%ny_arrow_sound%~ #8
  WRITE_BYTE   0x217 ny_expl_effect
  WRITE_BYTE   0x218 ny_expl_color
  WRITE_ASCII  0x21c ~~ #8          // no fire explosion animation
  WRITE_ASCII  0x230 ~~ #8          // no flame ring
  WRITE_LONG   0x240 0              // extended area flags of the VVC/ring
BUT_ONLY
ADD_PROJECTILE ~%ny_workspace%/NY#BDBBP.pro~
OUTER_SET ny_pro_bball = IDS_OF_SYMBOL (~projectl~ ~NY#BDBBP~) + 1

// Main spell: same damage steps as Acid Breath
CREATE ~SPL~ ~NY#BDBB~
  LPF NY#SPL_BASE INT_VAR name = ny_str_bball desc = ny_str_bball_d type = 1 level = 3 flags = 0x400
                          school = 6 exclusion = 0x200 graphics = 15 STR_VAR icon = ~NY#BDBBC~ END
  FOR (i = 0; i < 6; ++i) BEGIN
    SET lvl  = (i = 0) ? 1 : (3 * i + 3)       // 1 (5th), 6, 9, 12, 15, 18
    SET dice = 3 + i                             // 3d8 .. 8d8
    LPF NY#ADD_SPL_HEADER INT_VAR location = 2 target = 4 range = 40 level = lvl casting_time = 3 projectile = ny_pro_bball STR_VAR icon = ~NY#BDBBB~ RET h = header END
    LPF ADD_SPELL_EFFECT INT_VAR header = h opcode = 12 target = 2 timing = 1 parameter2 = 0x10000 dicenumber = dice dicesize = 8
                                 savingthrow = 2 special = 0x100 resist_dispel = 1 END
  END

ADD_SPELL ~override/NY#BDBB.spl~ 2 3 ~WIZARD_NY_BREATHBALL~
