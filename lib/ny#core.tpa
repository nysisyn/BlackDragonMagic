/////////////////////////////////////////////////////////////////////////////
// BlackDragonMagic - shared helpers
//
// The mod's spells, items, creatures and projectiles are stored in the mod
// (spl/, itm/, cre/, pro/...) and copied at install. The few values that
// depend on the game and on the mods installed before are written at
// install: names and descriptions (SAY), spell states, SPLPROT rows,
// projectile numbers (NY#PLACEHOLDERS below) and the creature animation id.
/////////////////////////////////////////////////////////////////////////////


/////////////////////////////////////////////////////////////////////////////
// NY#PLACEHOLDERS (patch)
// Replaces the placeholders of a stored SPL or ITM by the values of this
// install. Placeholders (as they appear in Near Infinity):
//   opcode 328, parameter 2 = 1000 + n   spell state n: $ny_ph_state(n)
//   opcodes 318, 324, 326, parameter 2 = 2000 + n
//                                        SPLPROT row "has spell state n":
//                                        $ny_ph_has(n)
//   extended header projectile = 3000 + n
//                                        projectile n: $ny_ph_pro(n)
// The lists n are set in tpa/kit.tpa. Any other value is left as it is.
/////////////////////////////////////////////////////////////////////////////
DEFINE_PATCH_FUNCTION NY#PLACEHOLDERS BEGIN
  READ_ASCII 0 sig (4)
  PATCH_IF (~%sig%~ STRING_EQUAL ~SPL ~) OR (~%sig%~ STRING_EQUAL ~ITM ~) BEGIN
    SET hsize = (~%sig%~ STRING_EQUAL ~SPL ~) ? 0x28 : 0x38
    SET hpro  = (~%sig%~ STRING_EQUAL ~SPL ~) ? 0x26 : 0x2a
    READ_LONG  0x64 ho
    READ_SHORT 0x68 hn
    READ_LONG  0x6a eo
    FOR (h = 0; h < hn; ++h) BEGIN
      READ_SHORT (ho + h * hsize + hpro) pro
      PATCH_IF (pro >= 3000) AND (pro < 3100) BEGIN
        SET n = pro - 3000
        WRITE_SHORT (ho + h * hsize + hpro) $ny_ph_pro(~%n%~)
      END
    END
    SET en = (BUFFER_LENGTH - eo) / 0x30          // every effect, global or not
    FOR (e = 0; e < en; ++e) BEGIN
      READ_SHORT (eo + e * 0x30)        op
      READ_LONG  (eo + e * 0x30 + 0x08) p2
      PATCH_IF (op = 328) AND (p2 >= 1000) AND (p2 < 1100) BEGIN
        SET n = p2 - 1000
        WRITE_LONG (eo + e * 0x30 + 0x08) $ny_ph_state(~%n%~)
      END
      PATCH_IF (op = 318 OR op = 324 OR op = 326) AND (p2 >= 2000) AND (p2 < 2100) BEGIN
        SET n = p2 - 2000
        WRITE_LONG (eo + e * 0x30 + 0x08) $ny_ph_has(~%n%~)
      END
    END
  END
END


/////////////////////////////////////////////////////////////////////////////
// NY#SPLPROT_ROW (action)
// Returns the row index of a SPLPROT.2DA entry identified by its label,
// appending it first if it does not exist yet. Used by opcode 324/318.
/////////////////////////////////////////////////////////////////////////////
DEFINE_ACTION_FUNCTION NY#SPLPROT_ROW
  STR_VAR
    label     = ~~
    stat      = ~~
    value     = ~~
    relation  = ~~
  RET
    row
BEGIN
  OUTER_SET row = "-1"
  COPY_EXISTING ~splprot.2da~ ~override~
    COUNT_2DA_ROWS 4 nrows
    FOR (r = 0; r < nrows; ++r) BEGIN
      READ_2DA_ENTRY r 0 4 lab
      PATCH_IF (~%lab%~ STRING_EQUAL_CASE ~%label%~) BEGIN
        SET row = r
      END
    END
  BUT_ONLY
  ACTION_IF (row < 0) BEGIN
    APPEND ~splprot.2da~ ~%label% %stat% %value% %relation%~
    COPY_EXISTING ~splprot.2da~ ~override~
      COUNT_2DA_ROWS 4 nrows
      SET row = nrows - 1
    BUT_ONLY
  END
END


/////////////////////////////////////////////////////////////////////////////
// NY#ADD_SPLSTATE (action)
// Adds a spell state to SPLSTATE.IDS (first free number) and returns it, to
// use with opcode 328 (special = 1) and SPLPROT stat 0x112. Reuses the entry
// when the name already exists (reinstall).
/////////////////////////////////////////////////////////////////////////////
DEFINE_ACTION_FUNCTION NY#ADD_SPLSTATE
  STR_VAR
    name  = ~~
  RET
    id
BEGIN
  OUTER_SET id = IDS_OF_SYMBOL (~splstate~ ~%name%~)
  ACTION_IF (id < 0) BEGIN
    COPY_EXISTING ~splstate.ids~ ~override~
      SET id = "-1"
      FOR (i = 0; (i < 256) AND (id < 0); ++i) BEGIN
        PATCH_IF (INDEX_BUFFER (EVALUATE_REGEXP ~^%i%[ %TAB%]~) < 0) BEGIN
          SET id = i
        END
      END
    BUT_ONLY
    ACTION_IF (id < 0) BEGIN
      FAIL ~BlackDragonMagic: no free spell state left in SPLSTATE.IDS~
    END
    APPEND ~splstate.ids~ ~%id% %name%~
  END
END


/////////////////////////////////////////////////////////////////////////////
// NY#ICON_B_FROM_C (action)
// With Remastered Spell Icons installed (ny_rsi, set in the tp2), copies the
// spellbook icon C (no stone plate) over the ability / memorised icon B, so
// the mod's icons match the remastered ones. Does nothing otherwise.
// Call it after the two BAMs have been copied to override.
/////////////////////////////////////////////////////////////////////////////
DEFINE_ACTION_FUNCTION NY#ICON_B_FROM_C
  STR_VAR
    b = ~~
    c = ~~
BEGIN
  ACTION_IF (ny_rsi) BEGIN
    COPY_EXISTING ~%c%.bam~ ~override/%b%.bam~
  END
END


/////////////////////////////////////////////////////////////////////////////
// NY#HEX4 (action)
// Returns a number as 4 uppercase hexadecimal digits, without "0x"
// (0xEC33 -> "EC33"), for animation INI file names and ANIMATE.IDS.
/////////////////////////////////////////////////////////////////////////////
DEFINE_ACTION_FUNCTION NY#HEX4
  INT_VAR
    value = 0
  RET
    hex
BEGIN
  OUTER_SPRINT hex ~~
  OUTER_FOR (k = 3; k >= 0; --k) BEGIN
    OUTER_SET d = (value BLSR (k * 4)) BAND 15
    ACTION_MATCH d WITH
      10 BEGIN OUTER_SPRINT c ~A~ END
      11 BEGIN OUTER_SPRINT c ~B~ END
      12 BEGIN OUTER_SPRINT c ~C~ END
      13 BEGIN OUTER_SPRINT c ~D~ END
      14 BEGIN OUTER_SPRINT c ~E~ END
      15 BEGIN OUTER_SPRINT c ~F~ END
      DEFAULT OUTER_SPRINT c ~%d%~
    END
    OUTER_SPRINT hex ~%hex%%c%~
  END
END


/////////////////////////////////////////////////////////////////////////////
// NY#NEW_ANIMATION (action)
// Gives a creature animation its id: the first free one from 0xEC40 to
// 0xECFF (no INI file, no ANIMATE.IDS entry), copies its INI file as
// <id>.INI and adds <symbol> to ANIMATE.IDS. Returns the id and its 4
// hexadecimal digits.
/////////////////////////////////////////////////////////////////////////////
DEFINE_ACTION_FUNCTION NY#NEW_ANIMATION
  STR_VAR
    ini    = ~~
    symbol = ~~
  RET
    id
    hex
BEGIN
  OUTER_SET id = "-1"
  OUTER_SPRINT hex ~~
  OUTER_FOR (a = 0xec40; (a <= 0xecff) AND (id < 0); ++a) BEGIN
    LAF NY#HEX4 INT_VAR value = a RET h = hex END
    OUTER_SET used = FILE_EXISTS_IN_GAME ~%h%.ini~
    ACTION_IF (NOT used) BEGIN
      COPY_EXISTING ~animate.ids~ ~override~
        PATCH_IF (INDEX_BUFFER (CASE_INSENSITIVE EVALUATE_REGEXP ~^0x%h%[ %TAB%]~) >= 0) BEGIN
          SET used = 1
        END
      BUT_ONLY
    END
    ACTION_IF (NOT used) BEGIN
      OUTER_SET id = a
      OUTER_SPRINT hex ~%h%~
    END
  END
  ACTION_IF (id < 0) BEGIN
    FAIL ~BlackDragonMagic: no free animation id between 0xEC40 and 0xECFF~
  END
  COPY ~%ini%~ ~override/%hex%.ini~
  ACTION_IF (IDS_OF_SYMBOL (~animate~ ~%symbol%~) < 0) BEGIN
    APPEND ~animate.ids~ ~0x%hex% %symbol%~
  END
END
