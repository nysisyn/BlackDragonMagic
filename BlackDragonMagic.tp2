BACKUP ~weidu_external/backup/BlackDragonMagic~
AUTHOR ~Nysi - https://github.com/nysisyn/BlackDragonMagic~
VERSION ~v0.2.0~

ALWAYS
  INCLUDE ~%MOD_FOLDER%/lib/ny#core.tpa~
  INCLUDE ~%MOD_FOLDER%/lib/a7#add_kit_ex.tpa~   // ADD_KIT_EX by Argent77 (public domain)

  // Game time: 1 round = 6 s, 1 turn = 60 s
  OUTER_SET ny_round = 6
  OUTER_SET ny_turn  = 60

  // Games with high-level abilities (Throne of Bhaal tables): the HLA and
  // the creature they call are only installed there
  OUTER_SET ny_hla = GAME_IS ~bg2ee eet iwdee~

  // Remastered Spell Icons (Renegade0): its spell icons have no stone plate.
  // When it is installed before this mod, our ability / memorised icons (B,
  // on a stone plate) are replaced by our spellbook icons (C, no plate) so
  // they match (NY#ICON_B_FROM_C in lib/ny#core.tpa).
  ACTION_IF (MOD_IS_INSTALLED ~remastered_spell_icons.tp2~ ~0~) BEGIN
    OUTER_SET ny_rsi = 1
  END ELSE BEGIN
    OUTER_SET ny_rsi = 0
  END
END

LANGUAGE ~English~
         ~english~
         ~%MOD_FOLDER%/lang/english/setup.tra~

LANGUAGE ~Francais~
         ~french~
         ~%MOD_FOLDER%/lang/english/setup.tra~
         ~%MOD_FOLDER%/lang/french/setup.tra~


// The Black Dragon Disciple: the kit, its Draconic Transformations, its
// breath spells, its other spells, its high-level abilities and the
// creature they call. One component: every file of the mod belongs to it.
BEGIN @1 DESIGNATED 0
LABEL ~BlackDragonMagic-BlackDragonDisciple~
REQUIRE_PREDICATE GAME_IS ~bgee bg2ee eet iwdee~ @10

WITH_TRA ~%MOD_FOLDER%/lang/english/kit.tra~
         ~%MOD_FOLDER%/lang/%LANGUAGE%/kit.tra~ BEGIN
  INCLUDE ~%MOD_FOLDER%/tpa/kit.tpa~
END
WITH_TRA ~%MOD_FOLDER%/lang/english/transformations.tra~
         ~%MOD_FOLDER%/lang/%LANGUAGE%/transformations.tra~ BEGIN
  INCLUDE ~%MOD_FOLDER%/tpa/transformations.tpa~
END
WITH_TRA ~%MOD_FOLDER%/lang/english/breath.tra~
         ~%MOD_FOLDER%/lang/%LANGUAGE%/breath.tra~ BEGIN
  INCLUDE ~%MOD_FOLDER%/tpa/breath.tpa~
END
WITH_TRA ~%MOD_FOLDER%/lang/english/spells.tra~
         ~%MOD_FOLDER%/lang/%LANGUAGE%/spells.tra~ BEGIN
  INCLUDE ~%MOD_FOLDER%/tpa/spells.tpa~
END
ACTION_IF ny_hla BEGIN
  WITH_TRA ~%MOD_FOLDER%/lang/english/creatures.tra~
           ~%MOD_FOLDER%/lang/%LANGUAGE%/creatures.tra~ BEGIN
    INCLUDE ~%MOD_FOLDER%/tpa/creatures.tpa~
  END
  WITH_TRA ~%MOD_FOLDER%/lang/english/hla.tra~
           ~%MOD_FOLDER%/lang/%LANGUAGE%/hla.tra~ BEGIN
    INCLUDE ~%MOD_FOLDER%/tpa/hla.tpa~
  END
END
// last: the global script and the spell list filter need every spell above
WITH_TRA ~%MOD_FOLDER%/lang/english/kit.tra~
         ~%MOD_FOLDER%/lang/%LANGUAGE%/kit.tra~ BEGIN
  INCLUDE ~%MOD_FOLDER%/tpa/global.tpa~
END
