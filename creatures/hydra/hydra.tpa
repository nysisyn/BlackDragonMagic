/////////////////////////////////////////////////////////////////////////////
// Test: hydra (BG2:EE and EET)
//
// The creature is built by hydra_creature.tpa (also used by the Black
// Dragon Disciple's Summon Reptile). This component adds the test creature
// NY#HYDR (hostile copy of the summoned hydra), to create with the console:
// CLUAConsole:CreateCreature("NY#HYDR"), and the spell Summon Hydra.
/////////////////////////////////////////////////////////////////////////////

ACTION_IF NOT FILE_EXISTS_IN_GAME ~ny#hyds.cre~ BEGIN
  INCLUDE ~%MOD_FOLDER%/creatures/hydra/hydra_creature.tpa~
END

OUTER_SET ny_str_hyis   = RESOLVE_STR_REF (@2)
OUTER_SET ny_str_hyis_d = RESOLVE_STR_REF (@3)

COPY ~%MOD_FOLDER%/creatures/hydra/bam/ny#hyisb.bam~ ~override~
     ~%MOD_FOLDER%/creatures/hydra/bam/ny#hyisc.bam~ ~override~
LAF NY#ICON_B_FROM_C STR_VAR b = ~NY#HYISB~ c = ~NY#HYISC~ END   // Remastered Spell Icons

// Test copy, hostile
COPY_EXISTING ~NY#HYDS.cre~ ~override/NY#HYDR.cre~
  WRITE_LONG  0x14 4000                         // experience
  WRITE_ASCII 0x250 ~~ #8                       // class
  WRITE_ASCII 0x260 ~~ #8                       // general
  WRITE_ASCII 0x268 ~WTASIGHT~ #8               // default: attacks on sight
  WRITE_BYTE  0x270 255                         // ENEMY

CREATE ~SPL~ ~NY#HYIS~
  LPF NY#SPL_BASE INT_VAR name = ny_str_hyis desc = ny_str_hyis_d type = 1 level = 9
                          school = 2 exclusion = 0x100 graphics = 14 STR_VAR icon = ~NY#HYISC~ END
  FOR (lvl = 18; lvl <= 40; ++lvl) BEGIN
    LPF NY#ADD_SPL_HEADER INT_VAR location = 2 target = 4 range = 30 level = ((lvl = 18) ? 1 : lvl) casting_time = 9 STR_VAR icon = ~NY#HYISB~ RET h = header END
    LPF ADD_SPELL_EFFECT INT_VAR header = h opcode = 67 target = 1 timing = 0 duration = ((10 + lvl) * ny_round) STR_VAR resource = ~NY#HYDS~ END
  END

ADD_SPELL ~override/NY#HYIS.spl~ 2 9 ~WIZARD_NY_SUMMON_HYDRA~
