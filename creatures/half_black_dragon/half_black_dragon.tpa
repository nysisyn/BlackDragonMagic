/////////////////////////////////////////////////////////////////////////////
// Nydra'Nath, the Half Black Dragon Spirit (BG2:EE and EET), called by Call
// Ancestor (kits/black_dragon_disciple/hla/hla.tpa, which includes this
// file). Needs ny_planetar: the CRE of Summon Planetar, used as the base: as
// strong as the planetar, it keeps the planetar's allegiance, summon AI
// (default script BDSUM00), immunities, regeneration, see invisible, magic
// resistance, resistances and its ring of protection from weapons below
// +3 (IMMUNE3); without its spells (and their script PLANGOOD) nor its
// voice.
//
// Animation NYHD: the half black dragon of Icewind Dale II (MDH1),
// converted for the Enhanced Edition by Nysi (works/: "Half Black Dragon
// Working Animation IWDEE"), monster_icewind type, files renamed NYHD*.
// Sounds HDRAG*.WAV: the half-dragon's of Siege of Dragonspear, copied only
// when the game lacks them (BG2:EE; EET has them).
//
//   NY#TANC  the spirit: level 25 fighter, 150 HP, AC -7, THAC0 3, 3 attacks
//            per round, STR 22, immune to acid; Blur (opcode 65) for its
//            ghostly look; no experience when killed
//   NY#TANW  its Ancestral Greatsword: two-handed sword +3, 1d10 slashing
//            + 2d6 acid; carries Blur, the immunities to poison and fear,
//            and to the disciple's own area spells and breaths (the spirit
//            stays out of its descendant's acid, roots, insects...)
/////////////////////////////////////////////////////////////////////////////

OUTER_SET ny_str_tanw   = RESOLVE_STR_REF (@271)
OUTER_SET ny_str_tanw_d = RESOLVE_STR_REF (@272)

COPY ~%MOD_FOLDER%/creatures/half_black_dragon/anim~ ~override~
ACTION_FOR_EACH snd IN hdrag01a hdrag01b hdrag02a hdrag03a hdrag03b hdrag04a hdrag04b hdrag05a hdrag05b
                       hdrag06a hdrag06b hdrag07a hdrag08a hdrag08b hdrag09a hdrag09b hdrag09c hdrag09d BEGIN
  ACTION_IF NOT FILE_EXISTS_IN_GAME ~%snd%.wav~ BEGIN
    COPY ~%MOD_FOLDER%/creatures/half_black_dragon/snd/%snd%.wav~ ~override~
  END
END
LAF NY#NEW_ANIMATION STR_VAR ini = EVAL ~%MOD_FOLDER%/creatures/half_black_dragon/ini/half_black_dragon.ini~
                             symbol = ~NY_HALF_BLACK_DRAGON~ RET ny_hbd_anim = id ny_hbd_hex = hex END
PRINT ~Half black dragon animation id: 0x%ny_hbd_hex%~

OUTER_SET ny_prof_2hsword = IDS_OF_SYMBOL (~stats~ ~PROFICIENCYTWOHANDEDSWORD~)

CREATE ~ITM~ ~NY#TANW~
  WRITE_LONG  0x08 ny_str_tanw
  WRITE_LONG  0x0c ny_str_tanw
  WRITE_LONG  0x18 0x42                         // two-handed, magical; not droppable
  WRITE_SHORT 0x1c 0x14                         // large sword
  WRITE_BYTE  0x31 ny_prof_2hsword
  WRITE_LONG  0x50 ny_str_tanw_d
  WRITE_LONG  0x54 ny_str_tanw_d
  WRITE_LONG  0x60 3                            // +3 weapon
  LPF ADD_ITEM_EQEFFECT INT_VAR opcode = 65  target = 1 timing = 2 END                   // Blur: the spirit
  LPF ADD_ITEM_EQEFFECT INT_VAR opcode = 101 target = 1 timing = 2 parameter2 = 25 END   // poison
  LPF ADD_ITEM_EQEFFECT INT_VAR opcode = 101 target = 1 timing = 2 parameter2 = 24 END   // panic
  LPF ADD_ITEM_EQEFFECT INT_VAR opcode = 101 target = 1 timing = 2 parameter2 = 23 END   // morale failure
  // the disciple's area spells and breaths
  PATCH_FOR_EACH r IN NY#TGCT NY#TGCV NY#TGCS NY#TGLA NY#TGLE NY#TGLI NY#TAMR NY#BDBL BEGIN
    LPF ADD_ITEM_EQEFFECT INT_VAR opcode = 206 target = 1 timing = 2 parameter1 = "-1" STR_VAR resource = EVAL ~%r%~ END
  END
  PATCH_FOR_EACH f IN A L B P BEGIN
    PATCH_FOR_EACH m IN N X BEGIN
      PATCH_FOR_EACH a IN 0 1 BEGIN
        LPF ADD_ITEM_EQEFFECT INT_VAR opcode = 206 target = 1 timing = 2 parameter1 = "-1" STR_VAR resource = EVAL ~NY#TB%f%%m%%a%~ END
        PATCH_FOR_EACH i IN 0 1 2 BEGIN
          PATCH_IF (~%f%~ STRING_EQUAL ~P~) BEGIN
            LPF ADD_ITEM_EQEFFECT INT_VAR opcode = 206 target = 1 timing = 2 parameter1 = "-1" STR_VAR resource = EVAL ~NY#TQ%m%%a%%i%~ END
          END
        END
      END
    END
  END
  LPF NY#ADD_ITM_HEADER INT_VAR attack_type = 1 id_req = 0 location = 1 target = 1 range = 1 speed = 7
                                thac0 = 3 dice_sides = 10 dice_thrown = 1 damage_bonus = 3 damage_type = 3 flags = 1
                       RET h = header END
  LPF ADD_ITEM_EFFECT INT_VAR type = 99 header = h opcode = 12 target = 2 timing = 1 parameter2 = 0x10000
                              dicenumber = 2 dicesize = 6 END                            // acid

COPY_EXISTING ~%ny_planetar%.cre~ ~override/NY#TANC.cre~
  WRITE_LONG  0x08 ny_str_spirit
  WRITE_LONG  0x0c ny_str_spirit
  WRITE_LONG  0x14 0                            // no experience when killed
  WRITE_SHORT 0x24 150                          // HP
  WRITE_SHORT 0x26 150
  WRITE_LONG  0x28 ny_hbd_anim
  WRITE_ASCII 0x34 ~~ #8                        // no portraits
  WRITE_ASCII 0x3c ~~ #8
  WRITE_SHORT 0x46 "-7"                         // AC (the planetar's)
  WRITE_SHORT 0x48 "-7"
  WRITE_BYTE  0x52 3                            // THAC0
  WRITE_BYTE  0x53 3                            // 3 attacks per round
  WRITE_BYTE  0x5c 100                          // acid
  // no planetar voice: the animation's sounds (INI) only
  FOR (o = 0xa4; o < 0x234; o += 4) BEGIN WRITE_LONG o "-1" END
  WRITE_BYTE  0x234 25                          // level
  WRITE_BYTE  0x238 22                          // STR
  WRITE_BYTE  0x239 0
  WRITE_BYTE  0x23a 14                          // INT
  WRITE_BYTE  0x23b 14                          // WIS
  WRITE_BYTE  0x23c 16                          // DEX
  WRITE_BYTE  0x23d 19                          // CON
  WRITE_BYTE  0x23e 16                          // CHA
  WRITE_LONG  0x244 0                           // no kit
  WRITE_ASCII 0x248 ~~ #8                       // no spell script (PLANGOOD)
  WRITE_BYTE  0x272 IDS_OF_SYMBOL (~race~ ~DRAGON~)
  WRITE_BYTE  0x273 IDS_OF_SYMBOL (~class~ ~FIGHTER~)
  WRITE_ASCII 0x2cc ~~ #8                       // no dialogue
  REMOVE_KNOWN_SPELLS
  REMOVE_MEMORIZED_SPELLS
  // the summons' AI (the planetar's own default script)
  WRITE_ASCII 0x268 ~~ #8
  PATCH_IF FILE_EXISTS_IN_GAME ~bdsum00.bcs~ BEGIN
    WRITE_ASCII 0x268 ~BDSUM00~ #8
  END
  // the planetar's sword replaced, its IMMUNE3 ring kept
  REPLACE_CRE_ITEM ~NY#TANW~ #0 #0 #0 ~NONE~ ~WEAPON1~ EQUIP TWOHANDED
